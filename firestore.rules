rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function facilityDoc(facilityId) {
      let facility = get(/databases/$(database)/documents/facilities/$(facilityId));
      return facility.data;
    }

    function facilityExists(facilityId) {
      return exists(/databases/$(database)/documents/facilities/$(facilityId));
    }

    function facilityRole(facilityId) {
      return facilityExists(facilityId) && facilityDoc(facilityId).roles != null && facilityDoc(facilityId).roles[request.auth.uid] != null
        ? facilityDoc(facilityId).roles[request.auth.uid]
        : null;
    }

    function isFacilityOwnerOrManager(facilityId) {
      return isAuthenticated() && facilityExists(facilityId) && (
        facilityDoc(facilityId).ownerUid == request.auth.uid ||
        (facilityDoc(facilityId).managers != null && facilityDoc(facilityId).managers[request.auth.uid] == true) ||
        facilityRole(facilityId) == 'owner' ||
        facilityRole(facilityId) == 'manager' ||
        facilityRole(facilityId) == 'admin'
      );
    }

    function isFacilityStaff(facilityId) {
      return isFacilityOwnerOrManager(facilityId) ||
        facilityRole(facilityId) == 'manager' ||
        facilityRole(facilityId) == 'employee';
    }

    function customDomainClaimHeldBy(facilityId, hostname) {
      return exists(/databases/$(database)/documents/customDomainClaims/$(hostname)) &&
        get(/databases/$(database)/documents/customDomainClaims/$(hostname)).data.facilityId == facilityId;
    }

    function customDomainWriteAllowed(facilityId, oldHost, newHost) {
      return newHost == oldHost ||
        newHost == null ||
        newHost == '' ||
        customDomainClaimHeldBy(facilityId, newHost);
    }

    function authEmailLower() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : null;
    }

    function isSuperAdmin() {
      // Superadmin access is granted via a server-set custom claim only, so an
      // unverified password account matching an allowlisted email cannot
      // impersonate an admin. Set with the `superadmin` custom claim.
      return request.auth != null && request.auth.token.superadmin == true;
    }

    // Viewer role + staff/owner: read calendar and shared lists (writes stay stricter per collection).
    function isFacilityViewer(facilityId) {
      return facilityExists(facilityId) && facilityRole(facilityId) == 'viewer';
    }

    function canReadFacilityCalendarAndLists(facilityId) {
      return isSuperAdmin() ||
        isFacilityStaff(facilityId) ||
        isFacilityViewer(facilityId);
    }

    // Client-written manual payment row in tenants/{id}/payments (see PaymentService.recordManualPayment).
    // Stripe/webhook rows stay server-only (different type / shape).
    function isManualTenantPaymentCreate(facilityId, tenantId) {
      return request.resource.data.keys().hasOnly([
          'facilityId',
          'tenantId',
          'type',
          'amountCents',
          'currency',
          'chargeType',
          'status',
          'description',
          'createdAt',
          'updatedAt',
          'createdBy',
          'failureCode',
          'failureMessage',
          // The facility payment this row copies, so voiding one finds the other.
          'facilityPaymentId'
        ]) &&
        request.resource.data.facilityId == facilityId &&
        request.resource.data.tenantId == tenantId &&
        request.resource.data.type == 'manual' &&
        (!('facilityPaymentId' in request.resource.data) ||
          (request.resource.data.facilityPaymentId is string && request.resource.data.facilityPaymentId.size() <= 128)) &&
        request.resource.data.amountCents is int &&
        request.resource.data.amountCents >= 1 &&
        request.resource.data.amountCents <= 1000000000 &&
        request.resource.data.currency == 'usd' &&
        request.resource.data.chargeType is string &&
        request.resource.data.chargeType.matches('^manual_[a-zA-Z0-9_]+$') &&
        request.resource.data.status == 'succeeded' &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 4000 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.failureCode == null &&
        request.resource.data.failureMessage == null;
    }

    // Client-written facility payment row (see PaymentService.recordManualPayment / LateLogicService).
  function facilityPaymentWriteForbiddenKeys() {
    return [
      'externalPaymentId',
      'transactionId',
      'quickbooksId',
      'quickbooksSyncStatus',
      'stripePaymentIntentId',
      'stripeChargeId',
      'type',
      'amountCents',
    ];
  }

  function accountEntitlementWriteForbiddenKeys() {
    return [
      'subscriptionStatus',
      'stripeSubscriptionId',
      'stripeCustomerId',
      'subscriptionCurrentPeriodStart',
      'subscriptionCurrentPeriodEnd',
      'subscriptionCancelAtPeriodEnd',
      'subscriptionCanceledAt',
      'subscriptionTrialEnd',
      'suspended',
      'suspensionReason',
      'suspendedAt',
      'suspendedByUid',
      'suspendedByEmail',
      'referralCode',
      'referredByAccountId',
      'referralRewardPreferredFacilityId',
      'approvedAt',
      'rejectedAt',
      // Once-per-owner offer markers (see functions-shared platformCheckoutTrial.ts).
      // Clearing either would hand the owner a second trial or free month.
      'platformTrialUsedAt',
      'platformFirstMonthFreeUsedAt',
      // Exempts the account from billing entirely. Super-admin only, for the
      // operator's own account; self-granting it would be a free subscription.
      'billingExempt'
    ];
  }

  function facilityEntitlementWriteForbiddenKeys() {
    return [
      // Which account pays for this facility. Backend-only: several rules
      // resolve entitlement by reading this id and checking that the account's
      // subscription is 'active', without checking who owns that account. A
      // client that can rewrite this can point its facility at any paying
      // operator's account id and inherit premium entitlements (DNR access,
      // permanent tenant deletion) without paying.
      'facilityCreatorAccountId',
      // Payment-processor connection state. Backend-only: the scheduled autopay
      // job gates real charges on stripeStatus.chargesEnabled, so an owner must
      // not be able to set it from the client.
      'stripeConnectAccountId',
      'stripeConnectOnboardingComplete',
      'stripeStatus',
      'stripePlatformSubscriptionId',
      'platformSubscriptionStatus',
      'platformSubscriptionCurrentPeriodStart',
      'platformSubscriptionCurrentPeriodEnd',
      'platformSubscriptionCancelAtPeriodEnd',
      'platformSubscriptionTrialEnd',
      'stripeWebsiteSubscriptionId',
      'websiteSubscriptionStatus',
      'websiteSubscriptionCurrentPeriodEnd',
      'websiteSubscriptionCancelAtPeriodEnd',
      'websiteCheckoutSessionId',
      'websiteAdminTrialEndsAt',
      'websiteAdminTrialGrantedAt',
      'websiteAdminTrialGrantedByUid',
      'websiteAdminTrialGrantedByEmail',
      'websiteAdminTrialReason',
      'websiteAdminTrialRevokedAt',
      'websiteAdminTrialRevokedByUid',
      'websiteAdminTrialRevokedByEmail',
      // Exempts the facility from billing entirely. Super-admin only, for the
      // operator's own sites; self-granting it would be a free subscription.
      'billingExempt',
      // The owner's account standing, copied here by functions-automation for
      // invited staff, who cannot read the account. The app lets staff in on
      // it, so an owner who could write it could keep their staff working
      // after their own access lapsed or was suspended.
      'ownerAccountStanding',

      // A2P 10DLC / Twilio registration state. Backend-only, and a genuine
      // privilege escalation if it is not: the SMS send path reads
      // textingOnboardingEnabled, a2pStatus and textingPlatformApproved
      // straight off this document, so an owner who could write them could
      // either mark themselves carrier-approved or switch the gate off
      // entirely, and send unregistered 10DLC traffic through the platform's
      // Twilio account. That is what gets a sender blocked and fined, and it
      // bypasses the superadmin approval step that exists to prevent it.
      // None of these are ever written by the client; every one is set by a
      // callable or the status poller.
      'textingOnboardingEnabled',
      'textingPlatformApproved',
      'textingPlatformApprovedAt',
      'textingPlatformApprovedBy',
      'a2pStatus',
      'a2pApprovedAt',
      'a2pRejectedAt',
      'a2pRejectionReason',
      'a2pSubmittedAt',
      'a2pLastError',
      'a2pLastUpdatedAt',
      'a2pRegistrationRequired',
      'a2pBundleReady',
      'a2pBundleApproved',
      'a2pBundleIssues',
      'a2pBundleEvaluatedAt',
      'a2pBundleProfileStatus',
      'a2pBundleProductStatus',
      'a2pBundleStatusUpdatedAt',
      'a2pProfileBundleSid',
      'twilioAccountSid',
      'twilioTrustProfileSid',
      'twilioTrustProductSid',
      'twilioBusinessInfoEndUserSid',
      'twilioAuthorizedRepEndUserSid',
      'twilioA2pProfileEndUserSid',
      'twilioAddressSid',
      'twilioAddressDocumentSid',
      'twilioBrandSid',
      'twilioCampaignSid',
      'twilioMessagingServiceSid',
      'twilioPhoneNumber',
      'twilioPhoneNumberSid',
      // The facility's own number: sendSMS sends From it once approved, and
      // the inbound webhook routes replies by it. Written only when a callable
      // buys the number (the app only ever re-saves the value it read).
      'twilioPhoneNumberE164',
      // Paid-step coordination (a2pSubmission.ts / a2pPaidSteps.ts). An owner
      // who could clear the lease could run two purchases at once; one who
      // could set a2pCampaignPending could make the poll file a campaign.
      'a2pSubmitLease',
      'a2pCampaignPending',
      'a2pCampaignFilingFailures',
      'a2pCampaignStatus',
      'a2pBrandStatus',
      'a2pBrandResubmitRequired',
      'a2pBrandResubmissions',
      'a2pLastResetOf',
      'a2pBundleProfilePolicySid',
      'a2pBundleProductPolicySid',
      'a2pAbandonedBundleSids',
      'twilioCampaignId',
      // What the filed campaign claims (consent methods, samples). Set only by
      // the submit callable after server-side validation; the poll refiles
      // from these, so they must not be client-editable.
      'textingConsentMethods',
      'textingSampleMessages',
      'textingUseCases',
      'textingConsentConfirmedAt'
    ];
  }

  function isManualCompletedFacilityPaymentCreate(facilityId) {
    return request.resource.data.keys().hasAll([
        'tenantId',
        'facilityId',
        'contractId',
        'amount',
        'status',
        'method',
        'paidAt',
        'paidDate',
        'dueDate',
        'createdAt',
        'updatedAt',
        'createdBy',
        'isActive',
      ]) &&
      !request.resource.data.keys().hasAny(facilityPaymentWriteForbiddenKeys()) &&
      request.resource.data.keys().size() >= 13 &&
      request.resource.data.keys().size() <= 17 &&
      request.resource.data.facilityId == facilityId &&
      request.resource.data.tenantId is string &&
      request.resource.data.contractId is string &&
      request.resource.data.amount is number &&
      request.resource.data.amount >= 0.01 &&
      request.resource.data.amount <= 10000000 &&
      request.resource.data.status == 'completed' &&
      request.resource.data.method is string &&
      request.resource.data.method.matches('^(creditCard|debitCard|bankTransfer|check|cash|square|stripe|venmo|zelle|other)$') &&
      request.resource.data.paidAt == request.time &&
      request.resource.data.paidDate == request.time &&
      request.resource.data.dueDate == request.time &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time &&
      request.resource.data.createdBy == request.auth.uid &&
      request.resource.data.isActive == true &&
      (!('tenantName' in request.resource.data) || request.resource.data.tenantName is string) &&
      (!('unitNumber' in request.resource.data) || request.resource.data.unitNumber is string) &&
      (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 4000)) &&
      // Check number or Venmo/Zelle reference from the Record payment dialog.
      (!('reference' in request.resource.data) || (request.resource.data.reference is string && request.resource.data.reference.size() <= 100));
  }

  function isLateFeeFacilityPaymentCreate(facilityId) {
    return request.resource.data.keys().hasOnly([
        'tenantId',
        'facilityId',
        'contractId',
        'amount',
        'status',
        'method',
        'dueDate',
        'notes',
        'createdAt',
        'updatedAt',
        'createdBy'
      ]) &&
      request.resource.data.facilityId == facilityId &&
      request.resource.data.tenantId is string &&
      request.resource.data.contractId is string &&
      request.resource.data.amount is number &&
      request.resource.data.amount >= 0.01 &&
      request.resource.data.amount <= 10000000 &&
      request.resource.data.status == 'pending' &&
      request.resource.data.method == 'cash' &&
      request.resource.data.dueDate == request.time &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time &&
      request.resource.data.createdBy == request.auth.uid &&
      request.resource.data.notes is string &&
      request.resource.data.notes.size() <= 4000;
  }

  function isClientFacilityPaymentCreate(facilityId) {
    return isManualCompletedFacilityPaymentCreate(facilityId) ||
      isLateFeeFacilityPaymentCreate(facilityId);
  }

    function inviteDocPath(facilityId, inviteId) {
      return /databases/$(database)/documents/facilities/$(facilityId)/invites/$(inviteId);
    }

    // Invite acceptance: pending invite must match signed-in email and claimed role (see PermissionService.assignRole).
    function pendingInviteMatchesUserRoleWrite(facilityId, inviteId, roleType, assignedBy) {
      return inviteId is string &&
        exists(inviteDocPath(facilityId, inviteId)) &&
        get(inviteDocPath(facilityId, inviteId)).data.status == 'pending' &&
        get(inviteDocPath(facilityId, inviteId)).data.facilityId == facilityId &&
        authEmailLower() != null &&
        get(inviteDocPath(facilityId, inviteId)).data.emailLower == authEmailLower() &&
        get(inviteDocPath(facilityId, inviteId)).data.roleType == roleType &&
        get(inviteDocPath(facilityId, inviteId)).data.invitedBy == assignedBy;
    }

    // The accept write is set({roles: {<own uid>: <invite role>}, acceptingInviteId}, merge).
    // affectedKeys(), not changedKeys(): changedKeys() leaves out keys that are
    // added or removed, so the accept could also add or remove other fields
    // or other users' roles. With no roles map yet, the new one may hold only
    // the invitee's own entry.
    function facilityInviteRoleMergeAllowed(facilityId) {
      return request.auth != null &&
        request.resource.data.acceptingInviteId is string &&
        request.resource.data.roles is map &&
        request.resource.data.roles[request.auth.uid] is string &&
        pendingInviteMatchesUserRoleWrite(
          facilityId,
          request.resource.data.acceptingInviteId,
          request.resource.data.roles[request.auth.uid],
          get(inviteDocPath(facilityId, request.resource.data.acceptingInviteId)).data.invitedBy
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'acceptingInviteId']) &&
        (
          ('roles' in resource.data && resource.data.roles is map)
            ? request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
            : request.resource.data.roles.keys().hasOnly([request.auth.uid])
        );
    }

    function stringMatchesTime(value) {
      return value is string &&
        value.size() == 5 &&
        value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidReminderChannels(channels) {
      return channels is list &&
        channels.size() > 0 &&
        channels.hasOnly(['email', 'sms', 'push', 'inApp']);
    }

    function isValidConversationCreate(facilityId) {
      // Private conversation validation (if isPrivate == true)
      let isPrivateConv = request.resource.data.isPrivate == true;
      let isGroupConv = !('isPrivate' in request.resource.data) || request.resource.data.isPrivate == false;
      
      // Validate private conversation requirements
      let privateValid = isPrivateConv && 
        request.resource.data.keys().hasAll([
          'facilityId',
          'title',
          'createdAt',
          'createdByUid',
          'createdByEmail',
          'createdByName',
          'isActive',
          'isPrivate',
          'participantUids',
          'participantNames'
        ]) &&
        request.resource.data.facilityId == facilityId &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.isPrivate == true &&
        request.resource.data.participantUids is list &&
        request.resource.data.participantUids.size() == 2 &&
        request.resource.data.participantUids.hasAny([request.auth.uid]) &&
        request.resource.data.participantNames is map &&
        request.resource.data.participantNames.keys().hasAll(request.resource.data.participantUids);
      
      // Validate group conversation requirements (default)
      let groupValid = isGroupConv &&
        request.resource.data.keys().hasAll([
          'facilityId',
          'title',
          'createdAt',
          'createdByUid',
          'createdByEmail',
          'createdByName',
          'isActive'
        ]) &&
        request.resource.data.facilityId == facilityId &&
        request.resource.data.createdByUid == request.auth.uid &&
        (!('isPrivate' in request.resource.data) || request.resource.data.isPrivate == false);
      
      return privateValid || groupValid;
    }
    
    function isPrivateConversationParticipant(facilityId, conversationId) {
      return exists(/databases/$(database)/documents/facilities/$(facilityId)/conversations/$(conversationId)) &&
             get(/databases/$(database)/documents/facilities/$(facilityId)/conversations/$(conversationId)).data.isPrivate == true &&
             get(/databases/$(database)/documents/facilities/$(facilityId)/conversations/$(conversationId)).data.participantUids.hasAny([request.auth.uid]);
    }

    function isValidMessageCreate(facilityId, conversationId) {
      return request.resource.data.keys().hasAll([
        'conversationId',
        'facilityId',
        'text',
        'createdAt',
        'senderUid',
        'senderEmail',
        'senderName',
        'readBy',
        'isActive'
      ]) &&
        request.resource.data.conversationId == conversationId &&
        request.resource.data.facilityId == facilityId &&
        request.resource.data.senderUid == request.auth.uid;
    }

    // Permanent tenant delete's subscription gate lives in the
    // deleteTenantsPermanently callable now (functions-shared
    // tenants/permanentDeleteRules.ts); tenant docs are super-admin delete only.
    function creatorAccountData(accountId) {
      return get(/databases/$(database)/documents/facilityCreatorAccounts/$(accountId)).data;
    }

    function isAccountOwner(accountId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/facilityCreatorAccounts/$(accountId)) &&
        get(/databases/$(database)/documents/facilityCreatorAccounts/$(accountId)).data.ownerUid == request.auth.uid;
    }
    
    // Users can only access their own user document
    match /users/{uid} {
      // Super admins can read/write all user documents
      allow read, write: if isSuperAdmin();
      
      // Users can read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      // REMOVED: Global read access for invites (security issue)
      // Invite lookups now use Cloud Function: lookupUserByEmail
      // This ensures secure, controlled user lookups with minimal data exposure
      // User-scoped rate limit counters - Cloud Functions only (Admin SDK bypasses rules)
      match /rateLimits/{docId} {
        allow read, write: if false;
      }
    }
    
    // Facility Creator Accounts - users can only access their own account
    match /facilityCreatorAccounts/{accountId} {
      // Allow read if user owns this account OR is superadmin (for platform-wide visibility)
      allow read: if request.auth != null && (isSuperAdmin() || resource.data.ownerUid == request.auth.uid);
      
      // Allow create if ownerUid matches current user
      allow create: if request.auth != null && 
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.keys().hasAll(['ownerUid', 'ownerEmail', 'ownerName', 'subscriptionStatus', 'createdAt', 'updatedAt']) &&
        request.resource.data.subscriptionStatus == 'pendingApproval' &&
        (!('stripeSubscriptionId' in request.resource.data) || request.resource.data.stripeSubscriptionId == null) &&
        (!('stripeCustomerId' in request.resource.data) || request.resource.data.stripeCustomerId == null) &&
        (!('subscriptionCurrentPeriodStart' in request.resource.data) || request.resource.data.subscriptionCurrentPeriodStart == null) &&
        (!('subscriptionCurrentPeriodEnd' in request.resource.data) || request.resource.data.subscriptionCurrentPeriodEnd == null) &&
        (!('subscriptionCancelAtPeriodEnd' in request.resource.data) || request.resource.data.subscriptionCancelAtPeriodEnd == false) &&
        (!('subscriptionCanceledAt' in request.resource.data) || request.resource.data.subscriptionCanceledAt == null) &&
        (!('subscriptionTrialEnd' in request.resource.data) || request.resource.data.subscriptionTrialEnd == null) &&
        (!('suspended' in request.resource.data) || request.resource.data.suspended == false) &&
        (!('suspensionReason' in request.resource.data) || request.resource.data.suspensionReason == null) &&
        (!('suspendedAt' in request.resource.data) || request.resource.data.suspendedAt == null) &&
        (!('suspendedByUid' in request.resource.data) || request.resource.data.suspendedByUid == null) &&
        (!('suspendedByEmail' in request.resource.data) || request.resource.data.suspendedByEmail == null) &&
        (!('referralCode' in request.resource.data) || request.resource.data.referralCode == null) &&
        (!('referredByAccountId' in request.resource.data) || request.resource.data.referredByAccountId == null) &&
        (!('referralRewardPreferredFacilityId' in request.resource.data) || request.resource.data.referralRewardPreferredFacilityId == null) &&
        (!('approvedAt' in request.resource.data) || request.resource.data.approvedAt == null) &&
        (!('rejectedAt' in request.resource.data) || request.resource.data.rejectedAt == null);
      
      // Allow update by owner or superadmin (for account interventions/suspension).
      allow update: if request.auth != null &&
        (
          isSuperAdmin() ||
          (
            resource.data.ownerUid == request.auth.uid &&
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(accountEntitlementWriteForbiddenKeys())
          )
        );
      
      // Allow delete only by owner
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      // Security Collections - account-scoped (Phase 2)
      match /security_events/{eventId} {
        allow read, write: if isAuthenticated() && isAccountOwner(accountId);
      }

      match /security_alerts/{alertId} {
        allow read, write: if isAuthenticated() && isAccountOwner(accountId);
      }

      match /security_settings/{settingId} {
        allow read, write: if isAuthenticated() && isAccountOwner(accountId);
      }
    }

    // Referral program indexes — written only by Cloud Functions (Admin SDK)
    match /referralLookup/{code} {
      allow read, write: if false;
    }
    match /referralRewardsPending/{id} {
      allow read, write: if false;
    }
    
    // Facilities - owner-based access with proper validation
    match /facilities/{facilityId} {
      // Allow read if user owns the facility, is a manager, has a role, OR is superadmin
      allow read: if request.auth != null && 
        (isSuperAdmin() ||
         resource.data.ownerUid == request.auth.uid || 
         resource.data.managers[request.auth.uid] != null ||
         resource.data.roles[request.auth.uid] != null);
      
      // Allow create only if ownerUid is set to current user and required fields present
      allow create: if request.auth != null && 
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.keys().hasAll(['name', 'ownerUid', 'createdAt', 'active']) &&
        request.resource.data.active == true &&
        !request.resource.data.keys().hasAny(facilityEntitlementWriteForbiddenKeys());
      
      // Allow update by owner or super admin, or invitee merging their own role + trace field (assignRole)
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        (
          resource.data.ownerUid == request.auth.uid &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(facilityEntitlementWriteForbiddenKeys())
        ) ||
        facilityInviteRoleMergeAllowed(facilityId)
      );
      
      // Owners delete through the deleteFacilityPermanently callable, which
      // removes the whole subtree. The app's own delete skipped subcollections
      // it couldn't delete (tenants among them) and then deleted this doc,
      // leaving tenant records with no facility.
      allow delete: if isSuperAdmin();
      
      // Sub-collections under facilities
      match /tenants/{tenantId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow create: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        allow update: if isSuperAdmin() ||
          (isFacilityOwnerOrManager(facilityId) && keepsTenantsOwnSmsOptOut());

        // A tenant's own SMS opt-out (texted STOP, declined texts at move-in,
        // "opted out" on an imported sheet) is theirs alone to reverse, by texting
        // START, which the server records with the Admin SDK (not subject to
        // these rules). Staff may reverse only an opt-out they made
        // themselves: smsConsentSource 'staff_removed'. Backstop for an app
        // save made from a copy of the tenant read before the STOP arrived.
        function tenantOwnsSmsOptOut(d) {
          return (d.get('smsOptOut', false) == true ||
                  d.get('smsConsentStatus', '') == 'opted_out') &&
            d.get('smsConsentSource', '') != 'staff_removed';
        }
        function keepsTenantsOwnSmsOptOut() {
          let before = resource.data;
          let after = request.resource.data;
          return !tenantOwnsSmsOptOut(before) || (
            (before.get('smsOptOut', false) != true || after.get('smsOptOut', false) == true) &&
            (before.get('smsConsentStatus', '') != 'opted_out' ||
              after.get('smsConsentStatus', '') == 'opted_out') &&
            (after.get('smsConsentStatus', '') != 'opted_in' ||
              before.get('smsConsentStatus', '') == 'opted_in') &&
            after.get('smsConsentSource', '') == before.get('smsConsentSource', '')
          );
        }
        // Owners and managers delete through the deleteTenantsPermanently
        // callable, which refuses tenants with billing or legal history or a
        // unit. A direct delete (an old app tab, the API) skipped that check
        // and orphaned the tenant's ledger, invoices and payments.
        allow delete: if isSuperAdmin();

        // Per-tenant insurance docs (InsuranceService: tenants/{tenantId}/insurance)
        match /insurance/{insuranceId} {
          allow read: if canReadFacilityCalendarAndLists(facilityId);
          allow create, update: if isSuperAdmin() || isFacilityStaff(facilityId);
          allow delete: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        }

        // Tenant Stripe billing (server-only writes; facility staff can read)
        match /billing/{billingDocId} {
          allow read: if isSuperAdmin() || isFacilityStaff(facilityId);
          allow write: if false; // Cloud Functions only
        }

        // Tenant payment rows: Stripe/webhook writes use Admin SDK. Staff may create manual-only rows.
        match /payments/{paymentId} {
          allow read: if isSuperAdmin() || isFacilityStaff(facilityId);
          allow create: if isSuperAdmin() || (isFacilityStaff(facilityId) && isManualTenantPaymentCreate(facilityId, tenantId));
          allow update, delete: if false;
        }

        // Contact logs subcollection
        match /contactLogs/{logId} {
          allow read: if isSuperAdmin() || isFacilityStaff(facilityId);
          allow create: if isSuperAdmin() || (isFacilityStaff(facilityId) &&
            request.resource.data.keys().hasAll([
              'tenantId',
              'facilityId',
              'type',
              'direction',
              'contactDate',
              'contactedBy',
              'isAutoGenerated',
              'createdAt'
            ]) &&
            request.resource.data.tenantId == tenantId &&
            request.resource.data.facilityId == facilityId &&
            request.resource.data.contactedBy == request.auth.uid &&
            request.resource.data.type is string &&
            request.resource.data.direction is string &&
            request.resource.data.contactDate is timestamp);
          allow update: if isSuperAdmin() || (isFacilityStaff(facilityId) &&
            (!('tenantId' in request.resource.data) || request.resource.data.tenantId == tenantId) &&
            (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId));
          allow delete: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        }

        // Payment methods subcollection
        match /paymentMethods/{methodId} {
          allow read: if isSuperAdmin() || isFacilityStaff(facilityId);
          allow create: if isSuperAdmin() || (isFacilityStaff(facilityId) &&
            request.resource.data.keys().hasAll([
              'tenantId',
              'facilityId',
              'type',
              'isDefault',
              'autopayEnabled',
              'isActive',
              'createdAt',
              'createdBy'
            ]) &&
            request.resource.data.tenantId == tenantId &&
            request.resource.data.facilityId == facilityId &&
            request.resource.data.createdBy == request.auth.uid &&
            request.resource.data.type is string &&
            request.resource.data.isDefault is bool &&
            request.resource.data.autopayEnabled is bool &&
            request.resource.data.isActive is bool);
          allow update: if isSuperAdmin() || (isFacilityStaff(facilityId) &&
            (!('tenantId' in request.resource.data) || request.resource.data.tenantId == tenantId) &&
            (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId) &&
            (!('type' in request.resource.data) || request.resource.data.type is string));
          allow delete: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        }
      }
      
      match /units/{unitId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow write: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        match /overlockEvents/{eventId} {
          allow read: if canReadFacilityCalendarAndLists(facilityId);
          allow create: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
          allow update, delete: if false;
        }
      }

      // Internal facility reservations (calendar). Public flow uses /publicReservations.
      match /reservations/{reservationId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow write: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
      }

      // Optional facility-level tenant insurance index (calendar aggregation)
      match /tenant_insurance/{insuranceId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow write: if isSuperAdmin() || isFacilityStaff(facilityId);
      }

      // Facility-level overlock schedule (calendar); distinct from units/.../overlockEvents
      match /overlocks/{overlockId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow write: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
      }

      // Facility-level settings (including settings/public used by online rentals)
      match /settings/{settingId} {
        allow read: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        allow create: if isSuperAdmin() || (
          isFacilityOwnerOrManager(facilityId) &&
          customDomainWriteAllowed(facilityId, null, request.resource.data.get('customDomain', null))
        );
        allow update: if isSuperAdmin() || (
          isFacilityOwnerOrManager(facilityId) &&
          customDomainWriteAllowed(facilityId, resource.data.get('customDomain', null), request.resource.data.get('customDomain', null))
        );
        allow delete: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
      }
      
      // Rate limit counters (per facility) - Cloud Functions only (Admin SDK bypasses rules)
      match /rateLimits/{windowId} {
        allow read, write: if false;
      }
      
      match /payments/{paymentId} {
        allow read: if isSuperAdmin() || isFacilityStaff(facilityId);
        allow create: if isSuperAdmin() || (isFacilityStaff(facilityId) && isClientFacilityPaymentCreate(facilityId));
        allow update, delete: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
      }

      match /contracts/{contractId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'facilityId',
            'facilityOwnerUid',
            'tenantId',
            'title',
            'type',
            'status',
            'createdAt',
            'createdBy',
            'isActive'
          ]) &&
          request.resource.data.facilityOwnerUid == facilityDoc(facilityId).ownerUid &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.type is string &&
          request.resource.data.status is string &&
          request.resource.data.isActive is bool &&
          (!('complianceStatus' in request.resource.data) || request.resource.data.complianceStatus == 'active');
        allow update: if isFacilityStaff(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId) &&
          (!('facilityOwnerUid' in request.resource.data) || request.resource.data.facilityOwnerUid == resource.data.facilityOwnerUid) &&
          (!('tenantId' in request.resource.data) || request.resource.data.tenantId == resource.data.tenantId);
        // Move-out operations require owner/manager permissions
        allow update: if isFacilityOwnerOrManager(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          (
            // Allow move-out status updates
            (!('moveOutStatus' in request.resource.data) || request.resource.data.moveOutStatus is string) &&
            (!('moveOutDate' in request.resource.data) || request.resource.data.moveOutDate is timestamp) &&
            (!('moveOutCharges' in request.resource.data) || request.resource.data.moveOutCharges is number) &&
            (!('moveOutRefund' in request.resource.data) || request.resource.data.moveOutRefund is number)
          );
        // Compliance operations (disable/enable) require owner/manager permissions
        allow update: if isFacilityOwnerOrManager(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          (
            (!('complianceStatus' in request.resource.data) || request.resource.data.complianceStatus is string) &&
            (!('disabledAt' in request.resource.data) || request.resource.data.disabledAt is timestamp) &&
            (!('disabledBy' in request.resource.data) || request.resource.data.disabledBy is string) &&
            (!('disabledReason' in request.resource.data) || request.resource.data.disabledReason is string)
          );
        // Super admin can disable any contract
        allow update: if isSuperAdmin() &&
          request.resource.data.facilityId == facilityId &&
          (
            (!('complianceStatus' in request.resource.data) || request.resource.data.complianceStatus is string) &&
            (!('disabledAt' in request.resource.data) || request.resource.data.disabledAt is timestamp) &&
            (!('disabledBy' in request.resource.data) || request.resource.data.disabledBy is string) &&
            (!('disabledReason' in request.resource.data) || request.resource.data.disabledReason is string)
          );
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }

      // Lease Templates (for E-sign)
      match /leaseTemplates/{templateId} {
        allow read: if isFacilityStaff(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'facilityId',
            'facilityOwnerUid',
            'name',
            'provider',
            'isActive',
            'createdAt',
            'createdBy'
          ]) &&
          request.resource.data.facilityOwnerUid == facilityDoc(facilityId).ownerUid &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.provider is string &&
          request.resource.data.isActive is bool;
        allow update: if isFacilityStaff(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId) &&
          (!('facilityOwnerUid' in request.resource.data) || request.resource.data.facilityOwnerUid == resource.data.facilityOwnerUid);
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }

      // E-sign Envelopes
      match /esignEnvelopes/{envelopeId} {
        allow read: if isFacilityStaff(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'facilityId',
            'facilityOwnerUid',
            'provider',
            'status',
            'providerEnvelopeId',
            'signerName',
            'signerEmail',
            'createdAt',
            'createdBy',
            'isActive'
          ]) &&
          request.resource.data.facilityOwnerUid == facilityDoc(facilityId).ownerUid &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.provider is string &&
          request.resource.data.status is string &&
          request.resource.data.isActive is bool;
        allow update: if isFacilityStaff(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId) &&
          (!('facilityOwnerUid' in request.resource.data) || request.resource.data.facilityOwnerUid == resource.data.facilityOwnerUid);
        // Removed: `allow update: if request.auth.token.firebase.sign_in_provider == 'custom'`.
        //
        // Its stated purpose was to let Cloud Functions write, but the Admin SDK
        // bypasses rules entirely, so it never served that. What it actually
        // granted was an unvalidated cross-facility update to any identity
        // holding a custom token. Nothing in this repo mints one today, so it is
        // dead as well as dangerous — and it would come alive silently the first
        // time someone adds custom tokens, for the tenant portal say.
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }

      // Leases collection (if separate from contracts)
      match /leases/{leaseId} {
        allow read: if isFacilityStaff(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'facilityId',
            'tenantId',
            'unitId',
            'moveInDate',
            'rentAmount',
            'status',
            'createdAt',
            'createdBy'
          ]) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.status is string &&
          request.resource.data.moveInDate is timestamp &&
          request.resource.data.rentAmount is number;
        allow update: if isFacilityStaff(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId) &&
          (!('tenantId' in request.resource.data) || request.resource.data.tenantId == resource.data.tenantId) &&
          (!('unitId' in request.resource.data) || request.resource.data.unitId == resource.data.unitId);
        // Move-out operations require owner/manager permissions
        allow update: if isFacilityOwnerOrManager(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          (
            (!('moveOutDate' in request.resource.data) || request.resource.data.moveOutDate is timestamp) &&
            (!('status' in request.resource.data) || request.resource.data.status in ['active', 'terminated', 'expired'])
          );
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }

      match /mapShapes/{shapeId} {
        // Allow read/write if user owns the facility or is a manager
        allow read, write: if isFacilityOwnerOrManager(facilityId);
      }

      // Map Engine V2 (versioned map builder + publish metadata)
      match /mapEngine/{docId} {
        allow read, write: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);

        match /{subPath=**} {
          allow read, write: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        }
      }

      // Audit logs for sensitive actions
      match /reminders/{reminderId} {
        allow read: if isFacilityStaff(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'tenantId',
            'facilityId',
            'type',
            'channels',
            'title',
            'message',
            'scheduledFor',
            'status',
            'createdAt',
            'updatedAt',
            'createdBy',
            'isActive'
          ]) &&
          request.resource.data.createdBy == request.auth.uid &&
          isValidReminderChannels(request.resource.data.channels);
        allow update: if isFacilityStaff(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId) &&
          (!('channels' in request.resource.data) || isValidReminderChannels(request.resource.data.channels)) &&
          (!('scheduledFor' in request.resource.data) || request.resource.data.scheduledFor is timestamp);
        allow delete: if isFacilityStaff(facilityId);
      }

      match /reminderSchedules/{scheduleId} {
        allow read: if isFacilityStaff(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'facilityId',
            'name',
            'type',
            'channels',
            'sendMode',
            'offsetDays',
            'sendTime',
            'autoSend',
            'isActive',
            'titleTemplate',
            'messageTemplate',
            'createdAt',
            'updatedAt',
            'createdBy'
          ]) &&
          request.resource.data.createdBy == request.auth.uid &&
          isValidReminderChannels(request.resource.data.channels) &&
          request.resource.data.offsetDays is int &&
          stringMatchesTime(request.resource.data.sendTime);
        allow update: if isFacilityStaff(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId) &&
          (!('channels' in request.resource.data) || isValidReminderChannels(request.resource.data.channels)) &&
          (!('offsetDays' in request.resource.data) || request.resource.data.offsetDays is int) &&
          (!('sendTime' in request.resource.data) ||
            request.resource.data.sendTime == null ||
            stringMatchesTime(request.resource.data.sendTime));
        allow delete: if isFacilityStaff(facilityId);
      }

      match /gateAccess/{accessId} {
        // Super admins read them too, as for the tenant and unit docs:
        // Unassign Tenant, archive and switching a tenant off turn their gate
        // codes off in the same transaction, which failed permission-denied
        // for a super admin with no role at the facility.
        allow read: if isSuperAdmin() || isFacilityStaff(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'facilityId',
            'accessCode',
            'isActive',
            'createdAt',
            'updatedAt',
            'createdBy'
          ]) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.accessCode is string &&
          request.resource.data.accessCode.size() > 0 &&
          (!('allowedDays' in request.resource.data) ||
            request.resource.data.allowedDays == null ||
            (request.resource.data.allowedDays is list &&
              request.resource.data.allowedDays.hasOnly(['Mon','Tue','Wed','Thu','Fri','Sat','Sun']))) &&
          (!('allowedStartTime' in request.resource.data) ||
            request.resource.data.allowedStartTime == null ||
            stringMatchesTime(request.resource.data.allowedStartTime)) &&
          (!('allowedEndTime' in request.resource.data) ||
            request.resource.data.allowedEndTime == null ||
            stringMatchesTime(request.resource.data.allowedEndTime));
        // A super admin with no role only switches a code off (the fields
        // TenantService's gate-off writes): not on again, and no code,
        // hours or tenant changed.
        allow update: if (isFacilityStaff(facilityId) ||
            (isSuperAdmin() &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'updatedAt', 'updatedBy']) &&
              request.resource.data.isActive == false)) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId) &&
          (!('accessCode' in request.resource.data) ||
            (request.resource.data.accessCode is string && request.resource.data.accessCode.size() > 0)) &&
          (!('allowedDays' in request.resource.data) ||
            request.resource.data.allowedDays == null ||
            (request.resource.data.allowedDays is list &&
              request.resource.data.allowedDays.hasOnly(['Mon','Tue','Wed','Thu','Fri','Sat','Sun']))) &&
          (!('allowedStartTime' in request.resource.data) ||
            request.resource.data.allowedStartTime == null ||
            stringMatchesTime(request.resource.data.allowedStartTime)) &&
          (!('allowedEndTime' in request.resource.data) ||
            request.resource.data.allowedEndTime == null ||
            stringMatchesTime(request.resource.data.allowedEndTime)) &&
          (!('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid);
        allow delete: if isFacilityStaff(facilityId);
      }

      match /emailUsage/{usageId} {
        allow read: if isFacilityStaff(facilityId);
        // The monthly send counter is server-only. The outbound-email path
        // increments emailMonthlyCount inside a transaction and refuses to send
        // once it passes the limit, so a client able to write or delete it could
        // reset its own counter and keep sending.
        //
        // A create must not carry a counter at all; an update must leave it
        // untouched. Deleting the month document zeroes the counter just as
        // effectively, so deletes are refused outright.
        allow create: if isFacilityOwnerOrManager(facilityId) &&
          !('emailMonthlyCount' in request.resource.data);
        allow update: if isFacilityOwnerOrManager(facilityId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['emailMonthlyCount']);
        allow delete: if false;
      }
      match /exportJobs/{jobId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow create: if isFacilityOwnerOrManager(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.status == 'pending';
        // Status, storage path, expiry, and download metadata are server-owned.
        allow update, delete: if false;
      }

      match /invites/{inviteId} {
        // get: invitee can open email link before sign-in (pending only); staff; or signed-in invitee
        allow get: if resource != null &&
          (
            resource.data.status == 'pending' ||
            isSuperAdmin() ||
            isFacilityOwnerOrManager(facilityId) ||
            (authEmailLower() != null &&
              'emailLower' in resource.data &&
              resource.data.emailLower == authEmailLower())
          );
        // list: management UI only (collection queries); not public listing
        allow list: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        allow create: if isSuperAdmin() ||
          (isFacilityOwnerOrManager(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'email',
            'emailLower',
            'roleType',
            'status',
            'invitedAt',
            'invitedBy'
          ]) &&
          request.resource.data.roleType is string &&
          request.resource.data.status == 'pending' &&
          request.resource.data.invitedBy == request.auth.uid &&
          request.resource.data.invitedAt is timestamp);
        allow update: if isSuperAdmin() ||
          (resource.data.facilityId != null && isFacilityOwnerOrManager(resource.data.facilityId)) ||
          (
            authEmailLower() != null &&
            resource.data.emailLower == authEmailLower() &&
            request.resource.data.emailLower == resource.data.emailLower &&
            request.resource.data.roleType == resource.data.roleType &&
            request.resource.data.invitedAt == resource.data.invitedAt &&
            request.resource.data.invitedBy == resource.data.invitedBy &&
            (!('invitedByEmail' in resource.data) || request.resource.data.invitedByEmail == resource.data.invitedByEmail) &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.acceptedBy == request.auth.uid &&
            request.resource.data.acceptedAt is timestamp
          );
        allow delete: if isSuperAdmin() || 
          (resource.data.facilityId != null && isFacilityOwnerOrManager(resource.data.facilityId));
      }

      match /digests/{digestId} {
        allow read, write: if isFacilityOwnerOrManager(facilityId);

        match /items/{itemId} {
          allow read, write: if isFacilityOwnerOrManager(facilityId);
        }
      }

      // DNR rules live in the granular "DNR Entries - facility-scoped (Phase 2)" block below.
      // (A broad read/write rule here would OR with that block and bypass its create-time
      // attestation requirement, so keep this spot rule-free.)

      // Shared team notes — readable by everyone who can use facility lists; editable by staff
      match /team_notes/{noteId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 8000 &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.updatedByUid == request.auth.uid &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.updatedAt is timestamp;
        allow update: if isFacilityStaff(facilityId) &&
          request.resource.data.body is string &&
          request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 8000 &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt is timestamp &&
          request.resource.data.updatedByUid == request.auth.uid;
        allow delete: if isFacilityStaff(facilityId);
      }

      // Team messaging (conversations and messages) - facility staff can read/write
      // Private conversations: only participants can access
      // Group conversations: all facility staff can access
      // SuperAdmin bypass: full access for admin account (e.g. after subscription payment)
      match /conversations/{conversationId} {
        // Read: facility staff, private participants, OR superadmin
        allow read: if isSuperAdmin() ||
                       isFacilityStaff(facilityId) || 
                       isPrivateConversationParticipant(facilityId, conversationId);
        
        // Create: facility staff or superadmin
        allow create: if isSuperAdmin() ||
                         (isFacilityStaff(facilityId) && isValidConversationCreate(facilityId));
        
        // Update: facility staff, participants, OR superadmin
        allow update: if isSuperAdmin() ||
                         isFacilityStaff(facilityId) || 
                         isPrivateConversationParticipant(facilityId, conversationId);
        
        // Delete: owners/managers or superadmin
        allow delete: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);

        match /messages/{messageId} {
          // Read: facility staff, participants, OR superadmin
          allow read: if isSuperAdmin() ||
                         isFacilityStaff(facilityId) || 
                         isPrivateConversationParticipant(facilityId, conversationId);
          
          // Create: facility staff or superadmin
          allow create: if isSuperAdmin() ||
                           (isFacilityStaff(facilityId) && isValidMessageCreate(facilityId, conversationId));
          
          // Update: facility staff, sender, OR superadmin
          allow update: if isSuperAdmin() ||
                           isFacilityStaff(facilityId) || 
                           (resource.data.senderUid == request.auth.uid);
          
          // Delete: owners/managers or superadmin
          allow delete: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        }
      }

      // Employee chat display names (facility-scoped; staff can read; self or owner/manager can write)
      match /employeeChatNames/{userId} {
        function validEmployeeChatNameWrite() {
          return request.resource.data.keys().hasOnly(['chatName', 'updatedAt']) &&
            request.resource.data.chatName is string &&
            request.resource.data.chatName.size() <= 80 &&
            request.resource.data.updatedAt is timestamp;
        }
        allow read: if isSuperAdmin() || isFacilityStaff(facilityId);
        allow create: if isSuperAdmin() ||
          (isFacilityStaff(facilityId) &&
            (request.auth.uid == userId || isFacilityOwnerOrManager(facilityId)) &&
            validEmployeeChatNameWrite());
        allow update: if isSuperAdmin() ||
          (isFacilityStaff(facilityId) &&
            (request.auth.uid == userId || isFacilityOwnerOrManager(facilityId)) &&
            validEmployeeChatNameWrite());
        allow delete: if isSuperAdmin() ||
          (isFacilityStaff(facilityId) &&
            (request.auth.uid == userId || isFacilityOwnerOrManager(facilityId)));
      }

      // SMS conversations - facility owner or manager access (SuperAdmin bypass)
      match /smsConversations/{conversationId} {
        allow read: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        allow create, update, delete: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);

        match /messages/{messageId} {
          allow read: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
          allow create, update, delete: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        }
      }

      match /map/{mapId} {
        allow read, write: if isFacilityOwnerOrManager(facilityId);
      }

      match /auditLogs/{logId} {
        // Read: Staff can read audit logs for their facility
        allow read: if isFacilityStaff(facilityId);
        // Write: Only system/authorized operations can create audit logs
        // Audit logs should be immutable once created
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'facilityId',
            'action',
            'entityType',
            'entityId',
            'userId',
            'userEmail',
            'timestamp',
            'changes',
            'metadata'
          ]) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.action is string &&
          request.resource.data.entityType is string &&
          request.resource.data.timestamp is timestamp;
        // Audit logs should not be updated or deleted (immutable)
        allow update: if false; // Audit logs are immutable
        allow delete: if isSuperAdmin(); // Only super admins can delete audit logs (for compliance)
      }

      match /billing/{billingId} {
        allow read, write: if isFacilityOwnerOrManager(facilityId);
      }

      // Email opt-outs (List-Unsubscribe). Written by Cloud Functions only.
      match /emailSuppressions/{suppressionId} {
        allow read, write: if false;
      }

      // Autopay events (Payments > Autopay tab activity). Written by Cloud Functions only.
      match /AutopayEvents/{eventId} {
        allow read: if isSuperAdmin() || isFacilityStaff(facilityId);
        allow write: if false; // Cloud Functions only
      }

      // Facility notifications (autopay, system alerts). Written by Cloud Functions; staff can read. Redirect /notifications -> Settings.
      match /Notifications/{notificationId} {
        allow read: if isSuperAdmin() || isFacilityStaff(facilityId);
        // Written by Cloud Functions only. Staff may mark one read (the
        // app's "Mark reviewed" / "Mark read") and change nothing else;
        // every client write was refused, so no alert could be cleared.
        allow update: if (isSuperAdmin() || isFacilityStaff(facilityId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
          request.resource.data.readAt is timestamp;
        allow create, delete: if false;
      }

      // Message logs - unified logging for all outbound communications
      match /messageLogs/{messageLogId} {
        // Read: Staff for this facility; super admins (collection-group review in app)
        allow read: if isSuperAdmin() || isFacilityStaff(facilityId);
        // Write: Only Cloud Functions can write message logs (client writes disallowed for security)
        allow write: if false; // All writes must go through Cloud Functions
      }

      // AI assistant audit (one document per user turn). Written only by Cloud Functions (Admin SDK).
      match /aiChatAuditLogs/{logId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }

      match /ledgers/{ledgerId} {
        // Read: Staff can read ledger entries
        allow read: if isFacilityStaff(facilityId);
        // Create: Staff can create ledger entries, but refunds require owner/manager
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'tenantId',
            'facilityId',
            'type',
            'amount',
            'entryDate',
            'status',
            'createdAt',
            'createdBy'
          ]) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.amount is number &&
          request.resource.data.type is string &&
          request.resource.data.status is string &&
          // Refunds require owner/manager permission
          (request.resource.data.type != 'refund' || isFacilityOwnerOrManager(facilityId));
        // Update: Only owner/manager can update ledger entries (for corrections)
        allow update: if isFacilityOwnerOrManager(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId) &&
          (!('tenantId' in request.resource.data) || request.resource.data.tenantId == resource.data.tenantId) &&
          // Voiding entries requires owner/manager
          (!('status' in request.resource.data) || 
            (request.resource.data.status == 'voided' && isFacilityOwnerOrManager(facilityId)) ||
            request.resource.data.status == resource.data.status);
        // Delete: Only owner/manager can delete (should be rare, prefer voiding)
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }

      match /invoices/{invoiceId} {
        allow read, write: if isFacilityOwnerOrManager(facilityId);
      }

      match /deposits/{depositId} {
        allow read, write: if isFacilityOwnerOrManager(facilityId);
      }

      // Insurance Plans - facility-scoped (Phase 2)
      match /insurancePlans/{planId} {
        allow read: if isFacilityStaff(facilityId);
        allow create: if isFacilityOwnerOrManager(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll(['name', 'monthlyPrice', 'coverageAmount', 'active', 'createdAt', 'updatedAt']);
        allow update: if isFacilityOwnerOrManager(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId);
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }

      match /liens/{lienId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow write: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
      }

      match /claims/{claimId} {
        allow read: if isFacilityStaff(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'facilityId',
            'tenantId',
            'incidentDate',
            'claimType',
            'status',
            'claimAmount',
            'deductibleAmount',
            'description',
            'filedDate',
            'createdBy',
            'createdAt'
          ]) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.claimType is string &&
          request.resource.data.status is string &&
          request.resource.data.claimAmount is number &&
          request.resource.data.deductibleAmount is number &&
          request.resource.data.incidentDate is timestamp &&
          request.resource.data.filedDate is timestamp;
        allow update: if isFacilityStaff(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId) &&
          (!('tenantId' in request.resource.data) || request.resource.data.tenantId == resource.data.tenantId) &&
          // Only owner/manager can change status
          (!('status' in request.resource.data) || isFacilityOwnerOrManager(facilityId));
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }

      match /products/{productId} {
        allow read, write: if isFacilityOwnerOrManager(facilityId);
        // Stock adjustment audit log (POS / inventory) — subcollection must be explicit
        match /stockAdjustments/{adjustmentId} {
          allow read, write: if isFacilityOwnerOrManager(facilityId);
        }
      }

      match /sales/{saleId} {
        allow read, write: if isFacilityOwnerOrManager(facilityId);
      }

      match /transfers/{transferId} {
        allow read, write: if isFacilityOwnerOrManager(facilityId);
      }

      match /documents/{documentId} {
        allow read: if isFacilityStaff(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'facilityId',
            'fileName',
            'fileUrl',
            'fileSize',
            'mimeType',
            'documentType',
            'category',
            'uploadedAt',
            'uploadedBy',
            'isActive'
          ]) &&
          request.resource.data.uploadedBy == request.auth.uid &&
          request.resource.data.fileName is string &&
          request.resource.data.fileUrl is string &&
          request.resource.data.fileSize is number &&
          request.resource.data.mimeType is string &&
          request.resource.data.documentType is string &&
          request.resource.data.category is string &&
          request.resource.data.uploadedAt is timestamp &&
          request.resource.data.isActive is bool;
        allow update: if isFacilityStaff(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId);
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }

      // Contract Templates - facility-scoped (Phase 2)
      match /contractTemplates/{templateId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow create: if isFacilityOwnerOrManager(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll(['name', 'content', 'createdAt', 'isActive', 'facilityId']) &&
          request.resource.data.createdBy == request.auth.uid &&
          (!('complianceStatus' in request.resource.data) || request.resource.data.complianceStatus == 'active');
        allow update: if isFacilityOwnerOrManager(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId);
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }

      // Rights Attestations - facility-scoped compliance records
      match /rightsAttestations/{attestationId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow create: if isFacilityStaff(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll([
            'facilityId',
            'uploaderUserId',
            'uploaderEmail',
            'timestamp',
            'tosVersion',
            'attestationText',
            'documentId'
          ]) &&
          request.resource.data.uploaderUserId == request.auth.uid;
        // No updates or deletes allowed - attestations are immutable
      }

      // Terms Acceptance - facility-level compliance
      match /compliance/termsAcceptance {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow create: if isFacilityOwnerOrManager(facilityId) &&
          request.resource.data.keys().hasAll([
            'acceptedAt',
            'acceptedByUserId',
            'tosVersion',
            'textHash'
          ]) &&
          request.resource.data.acceptedByUserId == request.auth.uid;
        // No updates or deletes - terms acceptance is immutable (new version = new document)
      }

      // DNR Entries - facility-scoped (Phase 2)
      // Super admins have full read/update/delete for platform moderation
      // (Do Not Rent Data Policy: SFC may deactivate or remove any entry).
      match /dnr/{dnrId} {
        allow read: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
        allow create: if isFacilityOwnerOrManager(facilityId) &&
          request.resource.data.facilityId == facilityId &&
          request.resource.data.keys().hasAll(['name', 'active', 'addedAt', 'addedByUid', 'facilityId']) &&
          // Submitter must attest the entry is factual, supported by records,
          // and not based on a protected characteristic (recorded with the entry).
          request.resource.data.accuracyAttestation == true &&
          // Entries are shared with other participating facilities, so the
          // submitter must be a registered DNR participant (terms + paid sub).
          (isSuperAdmin() || isDnrParticipant());
        allow update: if isSuperAdmin() || (
          isFacilityOwnerOrManager(facilityId) &&
          (!('facilityId' in request.resource.data) || request.resource.data.facilityId == facilityId)
        );
        allow delete: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
      }
      // Stays (short-term rentals). Module and automation switches plus the
      // confirmed zone. Readable by viewers too, so the app can tell whether
      // Stays is on; only the staysSetControls callable writes it.
      match /stayControls/{docId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow write: if false; // staysSetControls only
      }

      // True only once staysSetControls has switched Stays on for this
      // facility. Client creates of Stays docs require it, so nothing Stays
      // can be written from the app while the module is off.
      function stayModuleOn(facilityId) {
        let controls = /databases/$(database)/documents/facilities/$(facilityId)/stayControls/current;
        return exists(controls) && get(controls).data.get('moduleEnabled', false) == true;
      }
      // Stays listings. List fields (rates, tax lines, checklists) cannot be
      // checked element by element in rules, so only the callables write them.
      match /stayListings/{listingId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow write: if false; // staysSaveListing / staysBulkCreateRvSites validate list elements
      }

      // Wifi, door and gate codes, directions and house rules: staff read,
      // owners and managers write whitelisted string keys. Never public, never
      // in the export feed.
      match /stayListingAccess/{listingId} {
        function accessStr(k, max) {
          return request.resource.data.get(k, '') is string && request.resource.data.get(k, '').size() <= max;
        }
        allow read: if isFacilityStaff(facilityId);
        function listingAccessOk() {
          return isFacilityOwnerOrManager(facilityId)
            && request.resource.data.keys().hasOnly(['facilityId', 'listingId', 'wifiName', 'wifiPassword', 'staticDoorCode',
                 'lockboxCode', 'gateCode', 'parkingNotes', 'trashNotes', 'checkoutInstructions', 'directionsUrl', 'houseRules',
                 'updatedAt', 'updatedBy'])
            && request.resource.data.facilityId == facilityId && request.resource.data.listingId == listingId
            && accessStr('wifiName', 100) && accessStr('wifiPassword', 100) && accessStr('staticDoorCode', 40)
            && accessStr('lockboxCode', 40) && accessStr('gateCode', 40) && accessStr('parkingNotes', 2000)
            && accessStr('trashNotes', 2000) && accessStr('checkoutInstructions', 4000) && accessStr('directionsUrl', 500)
            && accessStr('houseRules', 4000)
            && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
        }
        allow create: if listingAccessOk() && stayModuleOn(facilityId);
        allow update: if listingAccessOk();
        allow delete: if false;
      }
      // Stays channel feeds and export links. The feed URL and the raw export
      // token are bearer secrets: they live in secret/ subdocs nobody reads,
      // owners, managers and super admins included.
      match /stayChannels/{channelId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow write: if false;
        match /secret/{docId} {
          allow read, write: if false;
        }
      }
      match /stayChannelBlocks/{channelId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow write: if false;
      }
      match /stayExportLinks/{linkId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow write: if false;
        match /secret/{docId} {
          allow read, write: if false;
        }
      }
      match /staySyncLog/{runId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow write: if false;
      }
      // Stays bookings and blocks. No personal data or money amounts here.
      // Creating, deleting, dates, listing, status and version go through the
      // callables (night locks must be transactional); staff may make quick
      // edits and check guests in and out. Viewers read the whole doc,
      // staffNotes and cleanerNotes included, and the app says so.
      match /stays/{stayId} {
        // Kept equal to STAY_STAFF_FIELDS in contracts.ts plus the stamp
        // (functions-stays stayWriter.test.ts compares them).
        function quickKeys() {
          return ['guestDisplayName', 'adults', 'children', 'pets', 'rvLengthFt', 'staffNotes', 'cleanerNotes', 'tags',
                  'messageMarks', 'arrivalState', 'checkedInAt', 'checkedOutAt', 'updatedAt', 'updatedBy'];
        }
        function quickValuesOk() {
          let d = request.resource.data;
          let marks = d.get('messageMarks', {});
          return d.get('guestDisplayName', '') is string && d.get('guestDisplayName', '').size() <= 60
            && d.get('adults', 0) is int && d.get('adults', 0) >= 0 && d.get('adults', 0) <= 50
            && d.get('children', 0) is int && d.get('children', 0) >= 0 && d.get('children', 0) <= 50
            && d.get('pets', 0) is int && d.get('pets', 0) >= 0 && d.get('pets', 0) <= 20
            && (d.get('rvLengthFt', null) == null || (d.rvLengthFt is int && d.rvLengthFt >= 0 && d.rvLengthFt <= 80))
            && d.get('staffNotes', '') is string && d.get('staffNotes', '').size() <= 2000
            && d.get('cleanerNotes', '') is string && d.get('cleanerNotes', '').size() <= 2000
            // Up to 10 short tags. The rules cannot loop, and a check per
            // index costs more than the 1000-expression budget allows, so the
            // tags are joined: join() refuses maps and timestamps, and the
            // text must be 1-40 character pieces, 409 characters at most.
            // The app writes strings.
            && d.get('tags', []) is list && d.get('tags', []).size() <= 10
            && d.get('tags', []).join('|').size() <= 409
            && (d.get('tags', []).size() == 0 || d.get('tags', []).join('|').matches('[^|]{1,40}([|][^|]{1,40})*'))
            // templateKey → when it was copied: known-shape keys, and every
            // value either one already stored or this request's time.
            && marks is map && marks.size() <= 30
            && marks.keys().join('|').matches('([a-z0-9_]{1,40}([|][a-z0-9_]{1,40})*)?')
            && marks.values().hasOnly(resource.data.get('messageMarks', {}).values().concat([request.time]));
        }
        // Staff: upcoming → checked_in (a reservation that holds its nights)
        // and checked_in → checked_out (one that still does), each stamped
        // with request.time. Owners and managers may also undo either step,
        // which clears its time.
        function arrivalOk() {
          let b = resource.data.get('arrivalState', 'upcoming');
          let a = request.resource.data.get('arrivalState', 'upcoming');
          let holdsNights = resource.data.get('status', '') in ['confirmed', 'conflict'];
          let inAt = request.resource.data.get('checkedInAt', null);
          let outAt = request.resource.data.get('checkedOutAt', null);
          let inSame = inAt == resource.data.get('checkedInAt', null);
          let outSame = outAt == resource.data.get('checkedOutAt', null);
          return (a == b && inSame && outSame)
            || (b == 'upcoming' && a == 'checked_in' && resource.data.get('kind', '') == 'reservation'
                && holdsNights && inAt == request.time && outSame)
            || (b == 'checked_in' && a == 'checked_out' && holdsNights && outAt == request.time && inSame)
            || (isFacilityOwnerOrManager(facilityId)
                && ((b == 'checked_in' && a == 'upcoming' && inAt == null && outSame)
                    || (b == 'checked_out' && a == 'checked_in' && outAt == null && inSame)));
        }
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow create, delete: if false; // callables only: night locks must be transactional
        allow update: if isFacilityStaff(facilityId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(quickKeys())
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
          && quickValuesOk() && arrivalOk();
      }

      // Guest name, phone last 4, profile link and private notes: owners and
      // managers only. fullName may be null (a feed stay with no name yet).
      match /stayPrivate/{stayId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow create, delete: if false;
        allow update: if isFacilityOwnerOrManager(facilityId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'privateNotes', 'updatedAt', 'updatedBy'])
          && (request.resource.data.get('fullName', null) == null
              || (request.resource.data.fullName is string && request.resource.data.fullName.size() <= 120))
          && request.resource.data.get('privateNotes', '') is string && request.resource.data.get('privateNotes', '').size() <= 2000
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      }

      // A per-stay door or gate code: staff read (cleaners need it), owners
      // and managers write. Codes may be null.
      match /stayAccess/{stayId} {
        allow read: if isFacilityStaff(facilityId);
        function stayAccessOk() {
          return isFacilityOwnerOrManager(facilityId)
            && request.resource.data.keys().hasOnly(['facilityId', 'stayId', 'doorCode', 'gateCode', 'accessNotes', 'source',
                 'updatedAt', 'updatedBy'])
            && request.resource.data.facilityId == facilityId && request.resource.data.stayId == stayId
            && (request.resource.data.get('doorCode', null) == null
                || (request.resource.data.doorCode is string && request.resource.data.doorCode.size() <= 40))
            && (request.resource.data.get('gateCode', null) == null
                || (request.resource.data.gateCode is string && request.resource.data.gateCode.size() <= 40))
            && request.resource.data.get('accessNotes', '') is string && request.resource.data.get('accessNotes', '').size() <= 1000
            && request.resource.data.get('source', 'manual') in ['manual', 'phone_last4', 'static']
            && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
        }
        allow create: if stayAccessOk() && stayModuleOn(facilityId);
        allow update: if stayAccessOk();
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }

      match /stayFolios/{stayId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow write: if false;
      }

      // Night lock buckets: a cache only the stayWriter transaction writes.
      match /stayNightLocks/{bucketId} {
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow write: if false;
      }
      // Stays turnovers and to-dos. Automatic turnovers (turnover_{stayId})
      // come from the staysOnStayWrite trigger. Owners and managers edit the
      // task fields; an employee works tasks that are unassigned or theirs,
      // and only the checklist, supplies, issue note, photos and status.
      match /stayTasks/{taskId} {
        function empKeys() {
          return ['status', 'checklist', 'suppliesLow', 'issueNote', 'photoPaths', 'startedAt', 'completedAt', 'completedBy',
                  'updatedAt', 'updatedBy'];
        }
        function mgrKeys() {
          return empKeys().concat(['assigneeUid', 'assigneeName', 'dueByAt', 'dueByLocal', 'priority', 'title', 'notes',
                                   'needsAttention']);
        }
        // Every key a manual task may have: the task doc less the server's plannedDigest.
        function manualKeys() {
          return mgrKeys().concat(['facilityId', 'category', 'listingId', 'stayId', 'nextStayId', 'dueStartAt', 'dueStartLocal',
                                   'dueDate', 'sameDayTurn', 'createdBy', 'createdAt']);
        }
        function taskOk() {
          let d = request.resource.data;
          return d.get('status', '') in ['todo', 'in_progress', 'done', 'skipped', 'cancelled']
            && d.get('checklist', []) is list && d.get('checklist', []).size() <= 50
            && d.get('suppliesLow', []) is list && d.get('suppliesLow', []).size() <= 20
            && d.get('photoPaths', []) is list && d.get('photoPaths', []).size() <= 10
            && d.get('issueNote', '') is string && d.get('issueNote', '').size() <= 2000
            && d.get('title', '') is string && d.get('title', '').size() <= 120
            && d.get('notes', '') is string && d.get('notes', '').size() <= 2000
            && d.get('priority', 'normal') in ['normal', 'high']
            && d.get('needsAttention', false) is bool
            && d.get('updatedBy', null) == request.auth.uid && d.get('updatedAt', null) == request.time;
        }
        // Completion is signed and timed by whoever finishes the task, only
        // as it becomes done: completedBy is the signed-in user and
        // completedAt is request.time. Reopening may clear both; nothing
        // else may touch them. startedAt, when set, is request.time too.
        function completionOk() {
          let d = request.resource.data;
          let before = resource.data.get('status', '');
          let after = d.get('status', '');
          let touched = d.diff(resource.data).affectedKeys().hasAny(['completedAt', 'completedBy']);
          let startedOk = !d.diff(resource.data).affectedKeys().hasAny(['startedAt'])
            || d.get('startedAt', null) == null || d.get('startedAt', null) == request.time;
          return startedOk && (
            (after == 'done' && before != 'done')
              ? (d.get('completedBy', null) == request.auth.uid && d.get('completedAt', null) == request.time)
              : ((after != 'done' && before == 'done')
                  ? (!touched || (d.get('completedBy', null) == null && d.get('completedAt', null) == null))
                  : !touched));
        }
        function createdCompletionOk() {
          let d = request.resource.data;
          return (d.get('startedAt', null) == null || d.get('startedAt', null) == request.time)
            && ((d.get('status', '') == 'done')
                ? (d.get('completedBy', null) == request.auth.uid && d.get('completedAt', null) == request.time)
                : (d.get('completedBy', null) == null && d.get('completedAt', null) == null));
        }
        allow read: if canReadFacilityCalendarAndLists(facilityId);
        allow create: if isFacilityOwnerOrManager(facilityId) && stayModuleOn(facilityId) && !taskId.matches('^turnover_.*')
          && request.resource.data.get('facilityId', null) == facilityId
          && request.resource.data.keys().hasAll(['facilityId', 'category', 'title', 'status', 'dueDate', 'createdBy',
               'createdAt', 'updatedAt', 'updatedBy'])
          && request.resource.data.keys().hasOnly(manualKeys())
          && request.resource.data.category in ['site_check', 'maintenance', 'restock', 'general']
          && request.resource.data.status in ['todo', 'in_progress', 'done']
          && request.resource.data.title is string && request.resource.data.title.size() >= 1
          && request.resource.data.dueDate is string && request.resource.data.dueDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
          && createdCompletionOk() && taskOk();
        allow update: if (isFacilityOwnerOrManager(facilityId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(mgrKeys()) && taskOk() && completionOk())
          || (facilityRole(facilityId) == 'employee'
              && resource.data.get('assigneeUid', null) in [null, request.auth.uid]
              && resource.data.get('status', '') in ['todo', 'in_progress', 'done']
              && request.resource.data.get('status', '') in ['todo', 'in_progress', 'done']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(empKeys()) && taskOk() && completionOk());
        allow delete: if false;
      }
      // Stays money: the income journal, expenses and Airbnb CSV import
      // records. Owners and managers read; only the callables write (the same
      // as sales, deposits and invoices). Stay money never touches ledgers.
      match /stayIncome/{entryId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow write: if false;
      }
      match /stayExpenses/{expenseId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow write: if false;
      }
      match /stayImportBatches/{batchId} {
        allow read: if isFacilityOwnerOrManager(facilityId);
        allow write: if false;
      }
      // Stays returning guests: personal data, owners and managers only.
      // Consent is stamped by the rules (request.time, the signed-in user);
      // stay counts are server-maintained. Delete removes personal data on
      // request. Email and phone may be null.
      match /stayGuestProfiles/{profileId} {
        function keysOk() {
          return request.resource.data.keys().hasOnly(['facilityId', 'name', 'nameLower', 'phoneE164', 'email', 'vehicle',
               'notes', 'doNotRent', 'doNotRentReason', 'consent', 'stayCount', 'lastStayAt', 'createdAt', 'createdBy',
               'updatedAt', 'updatedBy']);
        }
        function optStr(v, max) {
          return v == null || (v is string && v.size() <= max);
        }
        function vehicleOk(v) {
          return v == null || (v is map && v.keys().hasOnly(['plate', 'state', 'make', 'rvType', 'rvLengthFt'])
            && optStr(v.get('plate', null), 20) && optStr(v.get('state', null), 40)
            && optStr(v.get('make', null), 60) && optStr(v.get('rvType', null), 60)
            && (v.get('rvLengthFt', null) == null || (v.rvLengthFt is int && v.rvLengthFt >= 0 && v.rvLengthFt <= 80)));
        }
        function valuesOk() {
          let d = request.resource.data;
          return d.get('facilityId', null) == facilityId
            && d.get('name', null) is string && d.name.size() >= 1 && d.name.size() <= 120 && d.get('nameLower', null) == d.name.lower()
            && (d.get('email', null) == null || (d.email is string && d.email.size() <= 200))
            && (d.get('phoneE164', null) == null || (d.phoneE164 is string && d.phoneE164.size() <= 20))
            && d.get('notes', '') is string && d.get('notes', '').size() <= 2000
            && d.get('doNotRent', false) is bool
            && (d.get('doNotRentReason', null) == null || (d.doNotRentReason is string && d.doNotRentReason.size() <= 500))
            && vehicleOk(d.get('vehicle', null))
            && d.get('updatedBy', null) == request.auth.uid && d.get('updatedAt', null) == request.time;
        }
        function consentStamped(c) {
          return c == null || (c.keys().hasOnly(['email', 'sms', 'method', 'recordedAt', 'recordedBy'])
            && c.get('email', null) is bool && c.get('sms', null) is bool
            && c.get('method', null) in ['verbal', 'written', 'booking_form']
            && c.get('recordedAt', null) == request.time && c.get('recordedBy', null) == request.auth.uid);
        }
        allow read, delete: if isFacilityOwnerOrManager(facilityId);
        allow create: if isFacilityOwnerOrManager(facilityId) && stayModuleOn(facilityId) && keysOk() && valuesOk()
          && request.resource.data.get('stayCount', 0) == 0
          && request.resource.data.get('lastStayAt', null) == null
          && request.resource.data.get('createdBy', null) == request.auth.uid
          && request.resource.data.get('createdAt', null) == request.time
          && consentStamped(request.resource.data.get('consent', null));
        allow update: if isFacilityOwnerOrManager(facilityId) && keysOk() && valuesOk()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stayCount', 'lastStayAt', 'createdAt',
               'createdBy', 'facilityId'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent'])
              || consentStamped(request.resource.data.get('consent', null)));
      }
      // Stays copy-first message templates. The owner copies, prints or
      // opens her own mail or text app; nothing sends them. No 'autoSend' key
      // exists in v1, and kind is always 'copy'. Only the server seeds
      // templates (seeded: true); who made one, and when, never changes.
      match /stayMessageTemplates/{templateId} {
        function templateOk() {
          let d = request.resource.data;
          return d.keys().hasOnly(['facilityId', 'key', 'name', 'body', 'channelHint', 'listingIds', 'kind',
               'seeded', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
            && d.get('facilityId', null) == facilityId && d.get('kind', null) == 'copy'
            && d.get('key', null) is string && d.key.matches('[a-z0-9_]{1,40}')
            && d.get('name', null) is string && d.name.size() <= 80
            && d.get('body', null) is string && d.body.size() <= 4000
            && d.get('channelHint', null) in ['airbnb_paste', 'email', 'sms', 'print']
            && d.get('listingIds', []) is list && d.get('listingIds', []).size() <= 60
            && d.get('updatedBy', null) == request.auth.uid
            && d.get('updatedAt', null) == request.time;
        }
        allow read: if isFacilityStaff(facilityId);
        allow create: if isFacilityOwnerOrManager(facilityId) && stayModuleOn(facilityId) && templateOk()
          && request.resource.data.get('seeded', false) == false
          && request.resource.data.get('createdBy', null) == request.auth.uid
          && request.resource.data.get('createdAt', null) == request.time;
        allow update: if isFacilityOwnerOrManager(facilityId) && templateOk()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['facilityId', 'seeded', 'createdAt', 'createdBy']);
        allow delete: if isFacilityOwnerOrManager(facilityId);
      }
    }
    
    // DNR entries in facility subcollections - facility owner access
    // REMOVED: Global dnr_entries collection (security issue - line 642-648)
    // DNR entries are now facility-scoped: facilities/{facilityId}/dnr/{dnrId}
    // See facility-scoped DNR rules below
    
    // Super-admin collection group queries (Platform Control → AI logs / Message logs tabs).
    // Nested facility rules are not enough for collectionGroup() list queries; use path=**.
    match /{path=**}/messageLogs/{messageLogId} {
      allow read: if isSuperAdmin();
    }

    match /{path=**}/aiChatAuditLogs/{logId} {
      allow read: if isSuperAdmin();
    }

    // Super-admin Websites tab reads facilities/{id}/settings/public across all
    // facilities via collectionGroup('settings'); the nested settings rule does
    // not authorize collection group list queries, so grant superadmin read here.
    match /{path=**}/settings/{settingId} {
      allow read: if isSuperAdmin();
    }

    // Collection group query for DNR entries across all facilities
    // Business requirement: participating facilities see DNR entries from other facilities.
    // Cross-facility visibility is limited to DNR participants (active paid subscription
    // + recorded DNR terms acceptance) and super admins; a facility can always read its
    // OWN entries via the facility-scoped rule above regardless of participation.
    // NOTE: no conditions on `path` here — collectionGroup() queries cannot evaluate
    // path-based conditions and fail closed with permission-denied. 'dnr' subcollections
    // only exist under facilities/{facilityId}, so the auth gate alone is sufficient.
    match /{path=**}/dnr/{dnrId} {
      allow read: if isSuperAdmin() || isDnrParticipant();
    }
    
    // REMOVED: Global contract_templates collection (security issue - line 655-658)
    // Contract templates are now facility-scoped: facilities/{facilityId}/contractTemplates/{templateId}
    // See facility-scoped contract template rules below
    
    // Legacy unit_maps collection - DEPRECATED, not used
    // New model uses facilities/{facilityId}/mapShapes (already scoped)
    // match /unit_maps/{mapId} {
    //   allow read, write: if request.auth != null && 
    //     (resource.data.ownerUid == request.auth.uid ||
    //      request.resource.data.ownerUid == request.auth.uid);
    // }
    
    // REMOVED: Global security_events, security_alerts, security_settings collections (security issue - lines 668-684)
    // Security collections are now account-scoped: facilityCreatorAccounts/{accountId}/security_*/
    // See account-scoped security rules below
    
    // -------------------------------------------------------------------------
    // DNR participation (Do Not Rent terms acceptance + subscription gate)
    // Shared DNR data (global_dnr_entries and cross-facility dnr collection-group
    // reads) is limited to "participating" operators: users on an active paid
    // subscription who have recorded a one-time acceptance of the DNR terms.
    // The acceptance doc is validated against the subscription at create time and
    // the subscription is re-checked on every read, so lapsed accounts lose access.
    // -------------------------------------------------------------------------
    // A paid subscription: 'active', or 'trialing' with a Stripe subscription
    // behind it whose recorded trial end is less than 3 days past (the
    // webhook that moves it on can lag the trial end). The first free month is
    // Stripe trial time, so an owner who subscribed with a card reads
    // 'trialing' until the first charge, and that counts as paid; a 'trialing'
    // record with an id whose trial end is long past, or missing, is stale and
    // does not. The unpaid app trial is 'trialing' with no subscription id.
    // Same rule as hasPaidOrCardTrialSubscription in functions-shared
    // (subscription/paidSubscription.ts, CARD_TRIAL_GRACE_MS) and the app
    // (lib/models/paid_subscription.dart, cardTrialGrace). The ids and trial
    // ends are backend-only (the entitlement forbidden-key lists).
    function accountPaidOrCardTrial(data) {
      return data.get('subscriptionStatus', '') == 'active' ||
        (
          data.get('subscriptionStatus', '') == 'trialing' &&
          data.get('stripeSubscriptionId', null) is string &&
          data.get('stripeSubscriptionId', '').size() > 0 &&
          data.get('subscriptionTrialEnd', null) is timestamp &&
          data.get('subscriptionTrialEnd', null) > request.time - duration.value(3, 'd')
        );
    }

    function facilityPaidOrCardTrial(data) {
      return data.get('platformSubscriptionStatus', '') == 'active' ||
        (
          data.get('platformSubscriptionStatus', '') == 'trialing' &&
          data.get('stripePlatformSubscriptionId', null) is string &&
          data.get('stripePlatformSubscriptionId', '').size() > 0 &&
          data.get('platformSubscriptionTrialEnd', null) is timestamp &&
          data.get('platformSubscriptionTrialEnd', null) > request.time - duration.value(3, 'd')
        );
    }

    function creatorAccountActiveOwnedBy(accountId) {
      return exists(/databases/$(database)/documents/facilityCreatorAccounts/$(accountId)) &&
        creatorAccountData(accountId).ownerUid == request.auth.uid &&
        accountPaidOrCardTrial(creatorAccountData(accountId));
    }

    function creatorAccountActive(accountId) {
      return exists(/databases/$(database)/documents/facilityCreatorAccounts/$(accountId)) &&
        accountPaidOrCardTrial(creatorAccountData(accountId));
    }

    // DNR is premium-only: a paid subscription, or the card-backed free month
    // (no unpaid app trial), matching the app's hasPremiumAccess. Accepts
    // either a per-facility platform sub or the linked creator account.
    function dnrFacilityHasPremium(facilityId) {
      return facilityExists(facilityId) && (
        facilityPaidOrCardTrial(facilityDoc(facilityId)) ||
        (
          'facilityCreatorAccountId' in facilityDoc(facilityId) &&
          facilityDoc(facilityId).facilityCreatorAccountId is string &&
          facilityDoc(facilityId).facilityCreatorAccountId.size() > 0 &&
          creatorAccountActive(facilityDoc(facilityId).facilityCreatorAccountId)
        )
      );
    }

    function dnrParticipantDoc() {
      return get(/databases/$(database)/documents/dnr_participants/$(request.auth.uid)).data;
    }

    function isDnrParticipant() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/dnr_participants/$(request.auth.uid)) &&
        dnrParticipantDoc().accepted == true &&
        (
          (
            'accountId' in dnrParticipantDoc() &&
            dnrParticipantDoc().accountId is string &&
            creatorAccountActive(dnrParticipantDoc().accountId)
          ) ||
          (
            'facilityId' in dnrParticipantDoc() &&
            dnrParticipantDoc().facilityId is string &&
            dnrFacilityHasPremium(dnrParticipantDoc().facilityId)
          )
        );
    }

    match /dnr_participants/{uid} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == uid);
      // Acceptance can only be recorded by the user themselves, and only while
      // they hold an active paid subscription (via their own creator account or
      // a facility they own/manage).
      allow create, update: if isAuthenticated() && request.auth.uid == uid
        && request.resource.data.accepted == true
        && request.resource.data.termsVersion is string
        && (
          (
            request.resource.data.accountId is string &&
            creatorAccountActiveOwnedBy(request.resource.data.accountId)
          ) ||
          (
            request.resource.data.facilityId is string &&
            isFacilityOwnerOrManager(request.resource.data.facilityId) &&
            dnrFacilityHasPremium(request.resource.data.facilityId)
          )
        );
      allow delete: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == uid);
    }

    // -------------------------------------------------------------------------
    // Global DNR (Do Not Rent) - platform-wide across all SFC operator accounts
    // ADDITIVE: New collection only; does not change facility-scoped DNR rules.
    // Read: participating operators only (active paid subscription + recorded
    // DNR terms acceptance) and super admins.
    // Write: facility owner/manager/admin only (enforced via createdByFacilityId).
    // -------------------------------------------------------------------------
    function isCreatorOrCreatorFacilityStaff(entryData) {
      return isAuthenticated() && (
        entryData.createdByUserId == request.auth.uid ||
        (entryData.createdByFacilityId is string && isFacilityOwnerOrManager(entryData.createdByFacilityId))
      );
    }
    match /global_dnr_entries/{entryId} {
      allow read: if isSuperAdmin() || isDnrParticipant();
      allow create: if isAuthenticated()
        && request.resource.data.createdByUserId == request.auth.uid
        && request.resource.data.createdByFacilityId is string
        && request.resource.data.createdByFacilityId.size() > 0
        && isFacilityOwnerOrManager(request.resource.data.createdByFacilityId)
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        // Submitter must attest the entry is factual, supported by records,
        // and not based on a protected characteristic (recorded with the entry).
        && request.resource.data.accuracyAttestation == true
        // Submitter must be a registered DNR participant (terms accepted + paid sub).
        && (isSuperAdmin() || isDnrParticipant());
      allow update, delete: if isSuperAdmin()
        || (resource != null && isCreatorOrCreatorFacilityStaff(resource.data));
      match /evidence/{evidenceId} {
        allow read: if isSuperAdmin() || isDnrParticipant();
        allow create, update, delete: if isSuperAdmin()
          || (get(/databases/$(database)/documents/global_dnr_entries/$(entryId)).data.createdByUserId == request.auth.uid
              || isFacilityOwnerOrManager(get(/databases/$(database)/documents/global_dnr_entries/$(entryId)).data.createdByFacilityId));
      }
    }

    // Rate limits for Cloud Functions (e.g. getContractBySigningToken) - Admin SDK only, deny client
    match /rateLimits/{docId} {
      allow read, write: if false; // Cloud Functions use Admin SDK (bypasses rules)
    }

    // System configuration - super admin only
    // Currently only used for system billing defaults (configs/system)
    match /configs/{configId} {
      // Only super admins can read/write system configs
      allow read, write: if request.auth != null && isSuperAdmin();
    }

    // App config (e.g. appConfig/aiAssistant) - read for authenticated users, write super admin only
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isSuperAdmin();
    }

    // Cancellation retention analytics — Admin SDK / callables only
    match /cancellationEvents/{eventId} {
      allow read: if request.auth != null && isSuperAdmin();
      allow write: if false;
    }

    // Public map snapshots are read-only and intentionally safe for anonymous access.
    match /publicFacilityMaps/{slug} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.facilityId is string &&
        isFacilityOwnerOrManager(request.resource.data.facilityId);
      // Authorize on the EXISTING doc only, and pin the owning facility.
      //
      // This previously also accepted `request.resource.data.facilityId`, i.e.
      // the incoming payload. Slugs are public (they are the storefront URL), so
      // any operator could PUT their own facilityId into an update and seize
      // another operator's slug: disable their storefront, or repoint its rent
      // and pay links at their own facility, custom domains included.
      allow update: if request.auth != null &&
        resource != null &&
        resource.data.facilityId is string &&
        isFacilityOwnerOrManager(resource.data.facilityId) &&
        request.resource.data.facilityId == resource.data.facilityId;
      allow delete: if request.auth != null &&
        resource.data.facilityId is string &&
        isFacilityOwnerOrManager(resource.data.facilityId);
    }

    // Public payment links (/pay?token=...). Doc ID equals data.token (unguessable).
    match /publicPaymentLinks/{linkId} {
      // Public reads are served by token-validating callables that return a
      // minimal response. Staff may still manage links for their own facility.
      allow get: if request.auth != null &&
        resource.data.facilityId is string &&
        isFacilityStaff(resource.data.facilityId);

      // Staff management UI: queries must only return docs the user may read (per-doc check).
      allow list: if request.auth != null &&
        resource.data.facilityId is string &&
        isFacilityStaff(resource.data.facilityId);

      // Link creation is server-only so token generation and tenant binding
      // cannot be bypassed by older or modified clients.
      allow create: if false;

      // Revoke pending links only. Marking paid should be done with Admin SDK (e.g. webhook).
      // affectedKeys() so a revoke can't also add or remove other fields.
      allow update: if request.auth != null &&
        resource.data.facilityId is string &&
        isFacilityStaff(resource.data.facilityId) &&
        request.resource.data.facilityId == resource.data.facilityId &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.token == resource.data.token &&
        request.resource.data.amount == resource.data.amount &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'revoked' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt']);

      allow delete: if false;
    }

    // Public reservations used by unauthenticated online rental flow.
    // NOTE: This collection is intentionally separate from facility private data.
    match /publicReservations/{reservationId} {
      // Public access and state changes are handled by token-validating
      // callables using the Admin SDK.
      allow get, create, update, delete: if false;
      allow list: if request.auth != null &&
        resource.data.facilityId is string &&
        isFacilityStaff(resource.data.facilityId);
    }
    
    // Super admin internal notes - only superadmin can read/write
    match /superAdminNotes/{noteId} {
      allow read, write: if request.auth != null && isSuperAdmin();
    }

    // Marketing website leads captured from public contact/trial form.
    // Read/write for super admins, with optional assignee-level updates.
    match /marketing_leads/{leadId} {
      allow read: if request.auth != null &&
        (isSuperAdmin() || resource.data.assignedToUid == request.auth.uid);
      allow create: if request.auth != null && isSuperAdmin();
      allow update: if request.auth != null &&
        (isSuperAdmin() || resource.data.assignedToUid == request.auth.uid);
      allow delete: if request.auth != null && isSuperAdmin();

      match /activities/{activityId} {
        allow read: if request.auth != null &&
          (isSuperAdmin() ||
           get(/databases/$(database)/documents/marketing_leads/$(leadId)).data.assignedToUid == request.auth.uid);
        allow create: if request.auth != null &&
          (isSuperAdmin() ||
           get(/databases/$(database)/documents/marketing_leads/$(leadId)).data.assignedToUid == request.auth.uid);
        allow update, delete: if request.auth != null && isSuperAdmin();
      }
    }

    // Locked commission payout periods and rep payout statuses.
    match /commission_payout_periods/{periodId} {
      allow read, write: if request.auth != null && isSuperAdmin();
      match /reps/{repId} {
        allow read, write: if request.auth != null && isSuperAdmin();
      }
    }

    // User roles collection - for permission system
    match /user_roles/{roleId} {
      // Super admins can read/write all roles
      allow read, write: if isSuperAdmin();
      
      // Users can read their own roles
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Facility owners/managers can read roles for their facilities
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/facilities/$(resource.data.facilityId)) &&
        (
          get(/databases/$(database)/documents/facilities/$(resource.data.facilityId)).data.ownerUid == request.auth.uid ||
          get(/databases/$(database)/documents/facilities/$(resource.data.facilityId)).data.managers[request.auth.uid] == true
        );
      
      // Allow create if user is super admin, facility owner, or has manageUsers permission
      allow create: if request.auth != null && (
        isSuperAdmin() ||
        (
          request.resource.data.userId is string &&
          request.resource.data.facilityId is string &&
          request.resource.data.roleType is string &&
          request.resource.data.assignedBy == request.auth.uid &&
          exists(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId)) &&
          (
            get(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId)).data.ownerUid == request.auth.uid ||
            get(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId)).data.managers[request.auth.uid] == true
          )
        ) ||
        (
          request.resource.data.inviteId is string &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.facilityId is string &&
          request.resource.data.roleType is string &&
          request.resource.data.assignedBy is string &&
          request.resource.data.isActive == true &&
          pendingInviteMatchesUserRoleWrite(
            request.resource.data.facilityId,
            request.resource.data.inviteId,
            request.resource.data.roleType,
            request.resource.data.assignedBy
          )
        )
      );
      
      // Allow update if super admin, facility owner, assignedBy self, or pending-invite acceptance (merge)
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        (
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.facilityId == resource.data.facilityId &&
          exists(/databases/$(database)/documents/facilities/$(resource.data.facilityId)) &&
          (
            get(/databases/$(database)/documents/facilities/$(resource.data.facilityId)).data.ownerUid == request.auth.uid ||
            get(/databases/$(database)/documents/facilities/$(resource.data.facilityId)).data.managers[request.auth.uid] == true ||
            resource.data.assignedBy == request.auth.uid
          )
        ) ||
        (
          request.resource.data.inviteId is string &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.facilityId == resource.data.facilityId &&
          request.resource.data.assignedBy == resource.data.assignedBy &&
          request.resource.data.roleType is string &&
          request.resource.data.assignedBy is string &&
          pendingInviteMatchesUserRoleWrite(
            resource.data.facilityId,
            request.resource.data.inviteId,
            request.resource.data.roleType,
            request.resource.data.assignedBy
          )
        )
      );

      allow delete: if request.auth != null && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/facilities/$(resource.data.facilityId)) &&
          (
            get(/databases/$(database)/documents/facilities/$(resource.data.facilityId)).data.ownerUid == request.auth.uid ||
            get(/databases/$(database)/documents/facilities/$(resource.data.facilityId)).data.managers[request.auth.uid] == true ||
            resource.data.assignedBy == request.auth.uid
          )
        )
      );
    }

    // Bug reports: any authenticated user can create; only superadmin can read/update/delete
    match /bug_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isSuperAdmin();
    }
    match /customDomainClaims/{hostname} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['facilityId', 'claimedAt']) &&
        request.resource.data.facilityId is string &&
        request.resource.data.claimedAt == request.time &&
        isFacilityOwnerOrManager(request.resource.data.facilityId);
      allow update: if false;
      allow delete: if request.auth != null &&
        (isSuperAdmin() || isFacilityOwnerOrManager(resource.data.facilityId));
    }
    // Automated platform-to-owner onboarding mail. A new owner has no facility
    // yet, so these cannot live under facilities/{id}/messageLogs. Written only
    // by the onboarding trigger via the Admin SDK; Platform Control reads them
    // so a super admin can see what went out, including what the pre-launch
    // gate suppressed.
    match /platformEmailLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false; // All writes go through Cloud Functions.
    }

    // A signed-in user with a verified email may list the invites addressed to
    // that email across facilities: collectionGroup('invites') filtered on
    // emailLower (PermissionService.fulfillPendingInvitesForUser, and the
    // account service's check for a pending invite). Without it that query was
    // refused, a fresh invited signup got no role, and the app took them for a
    // new owner. Verified only: an unverified account can carry anyone's
    // address, and listing would hand it invites it never received the link
    // for. Owner/manager listing and every write stay with the facility rule.
    match /{path=**}/invites/{inviteId} {
      allow list: if authEmailLower() != null &&
        request.auth.token.email_verified == true &&
        resource.data.emailLower == authEmailLower();
    }

    
  }
}
