# Copy to .env for local firebase deploy/emulator. Do not commit real secrets.
SENDGRID_SENDER_EMAIL=
SENDGRID_FROM_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_PHONE_NUMBER=
TWILIO_DRY_RUN=false
PUBLIC_APP_URL=https://app.storagefacilitycreator.com

# Required for non-interactive `firebase deploy` (CLI loads dotenv before param defaults apply).
SFC_LEAD_LINE_NUMBER=
SFC_LEAD_SMS_AUTO_REPLY=Thanks for contacting Storage Facility Creator. We got your message and will follow up shortly.
