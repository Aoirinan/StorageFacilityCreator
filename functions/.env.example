# Local / emulator only — copy to `.env` or `.env.storage-<project>` and fill in.
# Those files are gitignored; never commit real Twilio or SES secrets.
#
# Email compliance (optional; production defaults match app host if unset)
# PUBLIC_APP_URL=https://app.storagefacilitycreator.com
# SENDGRID_ASM_GROUP_ID=12345

# Firebase Hosting API (super-admin custom domains; defaults match prod project/site)
# HOSTING_PROJECT_ID=storage-facility-creator
# HOSTING_SITE_ID=storage-facility-creator

# Twilio (optional local smoke tests; production uses Firebase params + Secret Manager)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+15551234567
# TWILIO_DRY_RUN=false

# AWS SES Configuration
SES_REGION=us-east-2
SES_FROM_EMAIL=russellforsyth09091992@gmail.com
SES_ACCESS_KEY_ID=your_access_key_id_here
SES_SECRET_ACCESS_KEY=your_secret_access_key_here
