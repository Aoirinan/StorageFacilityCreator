{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint src/ --max-warnings 9999 --fix",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && node --test \"lib/test/**/*.test.js\"",
    "check:quickbooks": "node scripts/quickbooks-readiness-check.mjs",
    "migrate:email-limits": "node scripts/migrate_email_monthly_limits.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@sentry/node": "^10.41.0",
    "@sfc/functions-shared": "file:vendor/functions-shared",
    "dotenv": "^17.3.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.2.2",
    "google-auth-library": "^10.6.2",
    "nodemailer": "^8.0.0",
    "openai": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "stripe": "^20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^25.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
