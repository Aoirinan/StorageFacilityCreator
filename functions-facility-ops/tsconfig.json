{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@sfc/functions-shared": ["../functions-shared/lib/index.d.ts"],
      "@sfc/functions-shared/*": ["../functions-shared/lib/*"],
      "@sfc/functions-shared/init": ["../functions-shared/lib/init.d.ts"]
    }
  },
  "compileOnSave": true,
  "include": ["src"]
}
