rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isSuperAdmin() {
      // Superadmin access is granted via a server-set custom claim only, so an
      // unverified password account matching an allowlisted email cannot
      // impersonate an admin. Set with the `superadmin` custom claim.
      return request.auth != null && request.auth.token.superadmin == true;
    }
    function facilityDoc(facilityId) {
      return firestore.get(/databases/(default)/documents/facilities/$(facilityId)).data;
    }
    function facilityExists(facilityId) {
      return firestore.exists(/databases/(default)/documents/facilities/$(facilityId));
    }
    function facilityRole(facilityId) {
      return facilityExists(facilityId) &&
        facilityDoc(facilityId).roles != null &&
        facilityDoc(facilityId).roles[request.auth.uid] != null
          ? facilityDoc(facilityId).roles[request.auth.uid]
          : null;
    }
    function isFacilityOwnerOrManager(facilityId) {
      return signedIn() && facilityExists(facilityId) && (
        facilityDoc(facilityId).ownerUid == request.auth.uid ||
        (facilityDoc(facilityId).managers != null &&
          facilityDoc(facilityId).managers[request.auth.uid] == true) ||
        facilityRole(facilityId) == 'owner' ||
        facilityRole(facilityId) == 'manager' ||
        facilityRole(facilityId) == 'admin'
      );
    }

    function creatorAccountActive(accountId) {
      return accountId is string &&
        firestore.exists(/databases/(default)/documents/facilityCreatorAccounts/$(accountId)) &&
        firestore.get(/databases/(default)/documents/facilityCreatorAccounts/$(accountId)).data.subscriptionStatus == 'active';
    }

    function dnrFacilityHasPremium(facilityId) {
      return facilityId is string &&
        facilityExists(facilityId) &&
        (
          (
            facilityDoc(facilityId).platformSubscriptionStatus is string &&
            facilityDoc(facilityId).platformSubscriptionStatus == 'active'
          ) ||
          (
            facilityDoc(facilityId).facilityCreatorAccountId is string &&
            creatorAccountActive(facilityDoc(facilityId).facilityCreatorAccountId)
          )
        );
    }

    // Shared DNR evidence readable only by participating operators (recorded DNR
    // terms acceptance + active paid subscription), mirroring firestore.rules.
    function isDnrParticipant() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/dnr_participants/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/dnr_participants/$(request.auth.uid)).data.accepted == true &&
        (
          creatorAccountActive(
            firestore.get(/databases/(default)/documents/dnr_participants/$(request.auth.uid)).data.accountId
          ) ||
          dnrFacilityHasPremium(
            firestore.get(/databases/(default)/documents/dnr_participants/$(request.auth.uid)).data.facilityId
          )
        );
    }

    function globalDnrEntryAllowsEvidenceWrite(entryId) {
      return firestore.exists(/databases/(default)/documents/global_dnr_entries/$(entryId)) &&
        (
          firestore.get(/databases/(default)/documents/global_dnr_entries/$(entryId)).data.createdByUserId == request.auth.uid ||
          (
            firestore.get(/databases/(default)/documents/global_dnr_entries/$(entryId)).data.createdByFacilityId is string &&
            isFacilityOwnerOrManager(
              firestore.get(/databases/(default)/documents/global_dnr_entries/$(entryId)).data.createdByFacilityId
            )
          )
        );
    }
    
    // Per-user uploads
    match /uploads/{uid}/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    
    // Global DNR evidence — aligned with Firestore global_dnr_entries/{entryId}/evidence rules.
    // Path: dnrEvidence/{entryId}/{evidenceId}/{filename}
    match /dnrEvidence/{entryId}/{allPaths=**} {
      allow read: if isSuperAdmin() || isDnrParticipant();
      allow write: if signedIn() && (isSuperAdmin() || globalDnrEntryAllowsEvidenceWrite(entryId));
    }

    // Export files are server-owned and downloaded through short-lived signed URLs.
    match /exports/{facilityId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Public branding assets (online rentals logos, etc.).
    // Allow management by facility owner/manager and super admins.
    match /facilities/{facilityId}/public-branding/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin() || isFacilityOwnerOrManager(facilityId);
    }

    // Facility files - owner access only (covers contracts, DNR evidence, documents, invoices, etc.)
    // Path: facilities/{facilityId}/contracts/{contractId}/{fileName}
    // Path: facilities/{facilityId}/documents/{documentId}/{fileName}
    // Path: facilities/{facilityId}/invoices/{invoiceId}/invoice.pdf
    match /facilities/{facilityId}/{allPaths=**} {
      allow read, write: if signedIn() && 
        firestore.get(/databases/(default)/documents/facilities/$(facilityId)).data.ownerUid == request.auth.uid;
    }
    
    // Storage templates - DEPRECATED/UNUSED
    // Contract templates are now stored in Firestore (facilities/{facilityId}/contractTemplates)
    // If Storage templates are needed in future, move to facilities/{facilityId}/templates/
    // match /templates/{templateId}/{allPaths=**} {
    //   allow read: if signedIn();
    //   allow write: if signedIn();
    // }
    
    // If Storage templates are needed, use facility-scoped path:
    // match /facilities/{facilityId}/templates/{templateId}/{allPaths=**} {
    //   allow read, write: if signedIn() && 
    //     get(/databases/(default)/documents/facilities/$(facilityId)).data.ownerUid == request.auth.uid;
    // }
  }
}
