  },
  "dependencies": {
    "@sfc/functions-shared": "file:vendor/functions-shared",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.0.0"
  }
}
