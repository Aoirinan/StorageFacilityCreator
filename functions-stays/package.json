{
  "name": "functions-stays",
  "version": "1.0.0",
  "private": true,
  "description": "SFC Cloud Functions — Stays (short-term rentals): bookings, night locks, turnovers, channel sync, stay money",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npx tsc",
    "test": "npm run build && node --test \"lib/test/**/*.test.js\"",
