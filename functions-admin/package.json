{
  "name": "functions-admin",
  "version": "1.0.0",
  "private": true,
  "description": "SFC Cloud Functions — super-admin, diagnostics, and phase-2 migrations",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test:emulator": "npm run build && node ../firestore-rules-test/scripts/run-with-firestore-emulator.mjs \"node --test functions-admin/lib/test/emulator/*.test.js\"",
