{
  "name": "functions-automation",
  "version": "1.0.0",
  "private": true,
  "description": "SFC Cloud Functions — billing automation, delinquency, autopay, SMS reset, insurance schedules",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"lib/test/**/*.test.js\"",
    "test:emulator": "npm run build && node ../firestore-rules-test/scripts/run-with-firestore-emulator.mjs \"node --test --test-concurrency=1 functions-automation/lib/test/emulator/*.test.js\""
  },
  "dependencies": {
    "@sfc/functions-shared": "file:vendor/functions-shared",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.0",
    "stripe": "^20.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.0.0"
  }
}
