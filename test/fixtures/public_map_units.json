        "c2-13": { "isRentable": true, "status": "available" },
        "c3-13": { "isRentable": true, "status": "available" },
        "stale-label": { "isRentable": true, "status": "available" },
        "renamed": { "isRentable": false, "status": "rented" }
      }
    },
