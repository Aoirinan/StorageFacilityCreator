        { "id": "stale-label", "data": { "unitNumber": "OLD", "status": "available", "unitType": "standard" } },
        { "id": "renamed", "data": { "unitNumber": "NEW", "status": "available", "unitType": "standard" } }
      ],
      "tenants": [
        { "id": "t1", "data": { "name": "Al", "isActive": true, "unitNumber": "12", "unitId": "c3-12", "unitArea": "Complex 3" } },
