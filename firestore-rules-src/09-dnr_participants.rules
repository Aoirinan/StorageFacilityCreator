    // A paid subscription: 'active', or 'trialing' with a Stripe subscription
    // behind it. The first free month is Stripe trial time, so an owner who
    // subscribed with a card reads 'trialing' until the first charge, and that
    // counts as paid. The unpaid app trial is 'trialing' with no subscription
    // id. Same rule as hasPaidOrCardTrialSubscription in functions-shared
    // (subscription/paidSubscription.ts) and the app (lib/models/paid_subscription.dart).
    // Both ids are backend-only (the entitlement forbidden-key lists).
    function accountPaidOrCardTrial(data) {
      return data.get('subscriptionStatus', '') == 'active' ||
        (
          data.get('subscriptionStatus', '') == 'trialing' &&
          data.get('stripeSubscriptionId', null) is string &&
          data.get('stripeSubscriptionId', '').size() > 0
        );
    }

    function facilityPaidOrCardTrial(data) {
      return data.get('platformSubscriptionStatus', '') == 'active' ||
        (
          data.get('platformSubscriptionStatus', '') == 'trialing' &&
          data.get('stripePlatformSubscriptionId', null) is string &&
          data.get('stripePlatformSubscriptionId', '').size() > 0
        );
    }

    function creatorAccountActiveOwnedBy(accountId) {
      return exists(/databases/$(database)/documents/facilityCreatorAccounts/$(accountId)) &&
        creatorAccountData(accountId).ownerUid == request.auth.uid &&
        accountPaidOrCardTrial(creatorAccountData(accountId));
    }

    function creatorAccountActive(accountId) {
      return exists(/databases/$(database)/documents/facilityCreatorAccounts/$(accountId)) &&
        accountPaidOrCardTrial(creatorAccountData(accountId));
    }

    // DNR is premium-only: a paid subscription, or the card-backed free month
    // (no unpaid app trial), matching the app's hasPremiumAccess. Accepts
    // either a per-facility platform sub or the linked creator account.
    function dnrFacilityHasPremium(facilityId) {
      return facilityExists(facilityId) && (
        facilityPaidOrCardTrial(facilityDoc(facilityId)) ||
        (
          'facilityCreatorAccountId' in facilityDoc(facilityId) &&
          facilityDoc(facilityId).facilityCreatorAccountId is string &&
          facilityDoc(facilityId).facilityCreatorAccountId.size() > 0 &&
          creatorAccountActive(facilityDoc(facilityId).facilityCreatorAccountId)
        )
      );
    }

    function dnrParticipantDoc() {
      return get(/databases/$(database)/documents/dnr_participants/$(request.auth.uid)).data;
    }

    function isDnrParticipant() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/dnr_participants/$(request.auth.uid)) &&
        dnrParticipantDoc().accepted == true &&
        (
          (
            'accountId' in dnrParticipantDoc() &&
            dnrParticipantDoc().accountId is string &&
            creatorAccountActive(dnrParticipantDoc().accountId)
          ) ||
          (
            'facilityId' in dnrParticipantDoc() &&
            dnrParticipantDoc().facilityId is string &&
            dnrFacilityHasPremium(dnrParticipantDoc().facilityId)
          )
        );
    }

    match /dnr_participants/{uid} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == uid);
      // Acceptance can only be recorded by the user themselves, and only while
      // they hold an active paid subscription (via their own creator account or
      // a facility they own/manage).
      allow create, update: if isAuthenticated() && request.auth.uid == uid
        && request.resource.data.accepted == true
        && request.resource.data.termsVersion is string
        && (
          (
            request.resource.data.accountId is string &&
            creatorAccountActiveOwnedBy(request.resource.data.accountId)
          ) ||
          (
            request.resource.data.facilityId is string &&
            isFacilityOwnerOrManager(request.resource.data.facilityId) &&
            dnrFacilityHasPremium(request.resource.data.facilityId)
          )
        );
      allow delete: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == uid);
    }

    // -------------------------------------------------------------------------
    // Global DNR (Do Not Rent) - platform-wide across all SFC operator accounts
    // ADDITIVE: New collection only; does not change facility-scoped DNR rules.
    // Read: participating operators only (active paid subscription + recorded
    // DNR terms acceptance) and super admins.
    // Write: facility owner/manager/admin only (enforced via createdByFacilityId).
    // -------------------------------------------------------------------------
